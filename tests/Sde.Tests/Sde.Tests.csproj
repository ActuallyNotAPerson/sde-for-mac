<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3: a test project is an executable. -->
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sde.Calculation/Sde.Calculation.csproj" />
    <ProjectReference Include="../Sde.TestSupport/Sde.TestSupport.csproj" />
    <ProjectReference Include="../../src/Sde.Cli/Sde.Cli.csproj" />
  </ItemGroup>

  <!--
    The answer key (FEMA's decompiled engine, compiled unedited) is made locally by tools/answer-key/setup.sh and is not
    in the public repo. Without it the parity tests are skipped.
  -->
  <PropertyGroup Condition="Exists('../../reference/OriginalCalc/OriginalCalc.csproj') And Exists('../../decomp/CalculationEngine/CalculationEngine')">
    <HasAnswerKey>true</HasAnswerKey>
    <DefineConstants>$(DefineConstants);HAS_ANSWER_KEY</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(HasAnswerKey)' == 'true'">
    <ProjectReference Include="../../reference/OriginalCalc/OriginalCalc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Sde.TestSupport" />
  </ItemGroup>

</Project>
