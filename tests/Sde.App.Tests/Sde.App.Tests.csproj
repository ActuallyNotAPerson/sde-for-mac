<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI tests: the real Avalonia views rendered off-screen (Avalonia.Headless + Skia), driven through their view models. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Avalonia.Headless.XUnit 12 runs on xUnit v3, where a test project is an executable. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sde.App/Sde.App.csproj" />
    <ProjectReference Include="../Sde.TestSupport/Sde.TestSupport.csproj" />
  </ItemGroup>

  <!-- The recorded Census geocoder and FEMA NFHL answers, shared with the Interop tests (the network is never used). -->
  <ItemGroup>
    <None Include="../Sde.Interop.Tests/Fixtures/online/*.json" Link="Fixtures/online/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Sde.TestSupport" />
  </ItemGroup>

  <!-- The same files as SDE.app: no Svg packages (see the props file). -->
  <Import Project="../../src/Sde.App/LeaveOutSvg.props" />

</Project>
