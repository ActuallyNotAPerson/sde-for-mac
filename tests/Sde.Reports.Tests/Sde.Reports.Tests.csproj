<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders every report to PDF and checks the text with poppler (pdftotext/pdfinfo/pdfimages, from Homebrew). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3: a test project is an executable. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- SkiaSharp's own package carries only the macOS and Windows natives; this lets the tests run on Linux CI too. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sde.Reports/Sde.Reports.csproj" />
    <ProjectReference Include="../Sde.TestSupport/Sde.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Synthetic photos (generated, no third-party content). -->
    <None Include="Assets/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Sde.TestSupport" />
  </ItemGroup>

</Project>
