<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:f="using:Sde.App.ViewModels.Fields"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.App"
             Name="Substantial Damage Estimator"
             RequestedThemeVariant="Default">

  <!-- macOS application menu (replaces Avalonia's default "About Avalonia"). -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="About Substantial Damage Estimator" Click="OnAboutClicked" />
      <NativeMenuItemSeparator />
      <NativeMenuItem Header="Settings…" Gesture="Cmd+OemComma" Click="OnAboutClicked" />
    </NativeMenu>
  </NativeMenu.Menu>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Colours, type, spacing and sizes (the design tokens), the icons, and the app's control themes -->
        <ResourceInclude Source="avares://SDE/Styles/Tokens.axaml" />
        <ResourceInclude Source="avares://SDE/Styles/Icons.axaml" />
        <ResourceInclude Source="avares://SDE/Styles/Themes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <!-- One editor per kind of field; used by every form in the app. -->
    <DataTemplate DataType="f:TextFieldViewModel">
      <StackPanel Classes="field" Classes.wide="{Binding IsWide}" IsVisible="{Binding IsVisible}">
        <DockPanel Classes="fieldHead">
          <Button DockPanel.Dock="Right" Classes="link sm" Content="Insert snippet" IsVisible="{Binding HasSnippets}" IsEnabled="{Binding IsEnabled}" Padding="0"
                  AutomationProperties.Name="{Binding Label, StringFormat='Insert a snippet into {0}'}">
            <Button.Flyout>
              <MenuFlyout ItemsSource="{Binding SnippetItems}" />
            </Button.Flyout>
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="3">
            <TextBlock Classes="fieldLabel" Text="{Binding Label}" />
            <Button Classes="help" IsVisible="{Binding HasHelp}" Command="{Binding ShowHelpCommand}"
                    AutomationProperties.Name="{Binding Label, StringFormat='Help for {0}'}" ToolTip.Tip="What goes in this field">
              <c:Icon Kind="Info" Size="14" />
            </Button>
          </StackPanel>
        </DockPanel>
        <TextBox Text="{Binding Text}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}" PlaceholderText="{Binding Placeholder}" MaxLength="{Binding MaxLength}"
                 AcceptsReturn="{Binding IsMultiline}" TextWrapping="Wrap" IsEnabled="{Binding IsEnabled}"
                 Classes.multiline="{Binding IsMultiline}" />
        <TextBlock Classes="issue" Classes.required="{Binding IsRequiredIssue}" Classes.recommended="{Binding IsRecommendedIssue}"
                   Classes.suggested="{Binding IsSuggestedIssue}" Text="{Binding IssueMessage}" IsVisible="{Binding ShowIssueInline}" />
        <TextBlock Classes="help" Text="{Binding Help}" IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="f:NumberFieldViewModel">
      <StackPanel Classes="field" Classes.wide="{Binding IsWide}" IsVisible="{Binding IsVisible}">
        <DockPanel Classes="fieldHead">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <TextBlock Classes="fieldLabel" Text="{Binding Label}" />
            <Button Classes="help" IsVisible="{Binding HasHelp}" Command="{Binding ShowHelpCommand}"
                    AutomationProperties.Name="{Binding Label, StringFormat='Help for {0}'}" ToolTip.Tip="What goes in this field">
              <c:Icon Kind="Info" Size="14" />
            </Button>
          </StackPanel>
        </DockPanel>
        <NumericUpDown Value="{Binding Value}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}" FormatString="{Binding Format}" ShowButtonSpinner="False"
                       Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" PlaceholderText="{Binding Placeholder}"
                       IsEnabled="{Binding IsEnabled}" Classes="number">
          <NumericUpDown.InnerLeftContent>
            <TextBlock Classes="adorn" Text="{Binding Prefix}" Margin="10,0,0,0" IsVisible="{Binding Prefix, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </NumericUpDown.InnerLeftContent>
          <NumericUpDown.InnerRightContent>
            <TextBlock Classes="adorn" Text="{Binding Suffix}" Margin="0,0,10,0" IsVisible="{Binding Suffix, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </NumericUpDown.InnerRightContent>
        </NumericUpDown>
        <TextBlock Classes="issue" Classes.required="{Binding IsRequiredIssue}" Classes.recommended="{Binding IsRecommendedIssue}"
                   Classes.suggested="{Binding IsSuggestedIssue}" Text="{Binding IssueMessage}" IsVisible="{Binding ShowIssueInline}" />
        <TextBlock Classes="help" Text="{Binding Help}" IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="f:DateFieldViewModel">
      <StackPanel Classes="field" Classes.wide="{Binding IsWide}" IsVisible="{Binding IsVisible}">
        <DockPanel Classes="fieldHead">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <TextBlock Classes="fieldLabel" Text="{Binding Label}" />
            <Button Classes="help" IsVisible="{Binding HasHelp}" Command="{Binding ShowHelpCommand}"
                    AutomationProperties.Name="{Binding Label, StringFormat='Help for {0}'}" ToolTip.Tip="What goes in this field">
              <c:Icon Kind="Info" Size="14" />
            </Button>
          </StackPanel>
        </DockPanel>
        <CalendarDatePicker SelectedDate="{Binding Date}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}" IsEnabled="{Binding IsEnabled}" HorizontalAlignment="Stretch"
                            SelectedDateFormat="Custom" CustomDateFormatString="MMM d, yyyy" PlaceholderText="Pick a date" />
        <TextBlock Classes="issue" Classes.required="{Binding IsRequiredIssue}" Classes.recommended="{Binding IsRecommendedIssue}"
                   Classes.suggested="{Binding IsSuggestedIssue}" Text="{Binding IssueMessage}" IsVisible="{Binding ShowIssueInline}" />
        <TextBlock Classes="help" Text="{Binding Help}" IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="f:ChoiceFieldViewModel">
      <StackPanel Classes="field" Classes.wide="{Binding IsWide}" IsVisible="{Binding IsVisible}">
        <DockPanel Classes="fieldHead">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <TextBlock Classes="fieldLabel" Text="{Binding Label}" />
            <Button Classes="help" IsVisible="{Binding HasHelp}" Command="{Binding ShowHelpCommand}"
                    AutomationProperties.Name="{Binding Label, StringFormat='Help for {0}'}" ToolTip.Tip="What goes in this field">
              <c:Icon Kind="Info" Size="14" />
            </Button>
          </StackPanel>
        </DockPanel>
        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}" IsEnabled="{Binding IsEnabled}"
                  HorizontalAlignment="Stretch" MaxDropDownHeight="360" />
        <TextBlock Classes="issue" Classes.required="{Binding IsRequiredIssue}" Classes.recommended="{Binding IsRecommendedIssue}"
                   Classes.suggested="{Binding IsSuggestedIssue}" Text="{Binding IssueMessage}" IsVisible="{Binding ShowIssueInline}" />
        <TextBlock Classes="help" Text="{Binding Help}" IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="f:BoolFieldViewModel">
      <StackPanel Classes="field" Classes.wide="{Binding IsWide}" IsVisible="{Binding IsVisible}">
        <Panel Classes="fieldHead" />
        <StackPanel Orientation="Horizontal" Spacing="3">
          <CheckBox IsChecked="{Binding Value}" Content="{Binding Label}" IsEnabled="{Binding IsEnabled}" />
          <Button Classes="help" IsVisible="{Binding HasHelp}" Command="{Binding ShowHelpCommand}"
                  AutomationProperties.Name="{Binding Label, StringFormat='Help for {0}'}" ToolTip.Tip="What goes in this field">
            <c:Icon Kind="Info" Size="14" />
          </Button>
        </StackPanel>
        <TextBlock Classes="help" Text="{Binding Help}" IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <!-- Fluent, compact, with the brand accent (not the Mac's) for check boxes, switches, sliders and selection -->
    <FluentTheme DensityStyle="Compact">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="{StaticResource BrandAccentColor}" />
        <ColorPaletteResources x:Key="Dark" Accent="{StaticResource BrandAccentColor}" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://SDE/Styles/Typography.axaml" />
    <StyleInclude Source="avares://SDE/Styles/Buttons.axaml" />
    <StyleInclude Source="avares://SDE/Styles/Inputs.axaml" />
    <StyleInclude Source="avares://SDE/Styles/DataGrid.axaml" />
    <StyleInclude Source="avares://SDE/Styles/AppStyles.axaml" />
    <StyleInclude Source="avares://SDE/Styles/Shell.axaml" />
    <StyleInclude Source="avares://SDE/Styles/Editor.axaml" />
  </Application.Styles>
</Application>
