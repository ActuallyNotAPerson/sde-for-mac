<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sde.App.ViewModels"
             xmlns:c="using:Sde.App.Controls"
             xmlns:app="using:Sde.App"
             x:Class="Sde.App.Views.AssignmentsView"
             x:DataType="vm:AssignmentsViewModel">
  <DockPanel Margin="{StaticResource PagePadding}">
    <!-- The title band says "Assignments"; the header says which event -->
    <c:PageHeader DockPanel.Dock="Top" Subtitle="{Binding Subtitle}">
      <Button Command="{Binding NewTeamCommand}" AutomationProperties.Name="New team">
        <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="Plus" Size="12" /><TextBlock Text="New team…" /></StackPanel>
      </Button>
    </c:PageHeader>
    <TextBlock DockPanel.Dock="Bottom" Classes="muted" Margin="0,10,0,0" Text="{Binding Message}" AutomationProperties.LiveSetting="Polite"
               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <!-- No teams yet -->
    <Border Classes="card" IsVisible="{Binding HasNoTeams}">
      <c:EmptyState Icon="Assignments" Title="No teams yet"
                    Text="Make a team, then assign structures to it from Structures (Change, Assign to team) or from a selection on the map. Each team gets its structures in a driving order, a route sheet and field worksheets.">
        <Button Classes="primary" Command="{Binding NewTeamCommand}" AutomationProperties.Name="Make the first team">
          <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="Plus" Size="12" /><TextBlock Text="New team…" /></StackPanel>
        </Button>
      </c:EmptyState>
    </Border>

    <Grid ColumnDefinitions="300,*" ColumnSpacing="16" IsVisible="{Binding HasTeams}">
      <!-- Teams -->
      <Border Classes="card flush">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="h3" Text="Teams" Margin="16,14,16,8" />
          <ListBox ItemsSource="{Binding Teams}" SelectedItem="{Binding SelectedTeam}" Background="Transparent" AutomationProperties.Name="Teams">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TeamRowViewModel">
                <Grid ColumnDefinitions="Auto,*" Margin="4,6" AutomationProperties.Name="{Binding Name}">
                  <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Colour}" VerticalAlignment="Top" Margin="0,5,10,0" />
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Classes="medium" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Value="{Binding Fraction}" Maximum="1" Height="4" MinHeight="4" IsVisible="{Binding Assigned, Converter={x:Static app:Converters.IsPositive}}"
                                 AutomationProperties.AccessibilityView="Raw" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- The selected team's route -->
      <Border Grid.Column="1" Classes="card flush">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,14,16,10">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="h3" Text="{Binding TeamTitle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="muted" Text="{Binding TeamDetail}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <WrapPanel Grid.Column="1" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
              <Button Content="Order the route" Command="{Binding OrderRouteCommand}" IsEnabled="{Binding HasStops}"
                      ToolTip.Tip="A short driving order, by straight-line distance" />
              <Button Content="Route sheet…" Command="{Binding RouteSheetCommand}" IsEnabled="{Binding HasStops}" AutomationProperties.Name="Save the route sheet as a PDF" />
              <Button Content="Worksheets…" Command="{Binding WorksheetsCommand}" IsEnabled="{Binding HasStops}" AutomationProperties.Name="Save the field worksheets as a PDF" />
              <Button Content="Offline…" Command="{Binding KeepOfflineCommand}" IsEnabled="{Binding HasStops}"
                      AutomationProperties.Name="Keep the map around the team's structures on this Mac" ToolTip.Tip="Keep the background map around these structures on this Mac, for the field" />
              <Button Classes="icon" Command="{Binding EditTeamCommand}" AutomationProperties.Name="Edit the team" ToolTip.Tip="Edit the team">
                <c:Icon Kind="Edit" Size="14" />
              </Button>
              <Button Classes="icon" Command="{Binding RemoveTeamCommand}" AutomationProperties.Name="Remove the team" ToolTip.Tip="Remove the team">
                <c:Icon Kind="Trash" Size="14" />
              </Button>
            </WrapPanel>
          </Grid>

          <Grid DockPanel.Dock="Top" ColumnDefinitions="40,32,*,190,80,60,120,40" Margin="16,0,16,6" IsVisible="{Binding HasStops}">
            <TextBlock Grid.Column="1" Classes="eyebrow" Text="#" />
            <TextBlock Grid.Column="2" Classes="eyebrow" Text="STRUCTURE" />
            <TextBlock Grid.Column="3" Classes="eyebrow" Text="RESULT" />
            <TextBlock Grid.Column="4" Classes="eyebrow" Text="CODE" />
            <TextBlock Grid.Column="5" Classes="eyebrow" Text="DUE" />
            <TextBlock Grid.Column="6" Classes="eyebrow" Text="STATUS" />
          </Grid>
          <Button DockPanel.Dock="Bottom" Classes="link danger" Content="Take the ticked structures off the team…" Command="{Binding UnassignCommand}"
                  Margin="16,8,16,12" HorizontalAlignment="Left" IsVisible="{Binding HasStops}" />

          <Panel>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasStops}">
              <ItemsControl ItemsSource="{Binding Stops}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AssignmentRowViewModel">
                    <Border Classes="rule" Padding="16,4">
                      <Grid ColumnDefinitions="40,32,*,190,80,60,120,40">
                        <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Address, StringFormat='Tick {0}'}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Number}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="link" Content="{Binding Address}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Command="{Binding $parent[UserControl].((vm:AssignmentsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding OpenName}" />
                        <TextBlock Grid.Column="3" Classes="secondary" Text="{Binding Result}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Classes="mono sm" Text="{Binding Code}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Classes="secondary" Text="{Binding Due}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="6" ItemsSource="{x:Static vm:AssignmentsViewModel.StatusChoices}" SelectedIndex="{Binding StatusIndex}"
                                  AutomationProperties.Name="{Binding StatusName}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        <Button Grid.Column="7" Classes="icon sm" IsVisible="{Binding HasMapsLink}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding $parent[UserControl].((vm:AssignmentsViewModel)DataContext).DirectionsCommand}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding MapsName}" ToolTip.Tip="Directions in Maps">
                          <c:Icon Kind="MapPin" Size="14" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <c:EmptyState IsVisible="{Binding HasNoStops}" Icon="Assignments" Title="Nothing assigned"
                          Text="Assign structures to this team from Structures (Change, Assign to team) or from a selection on the map." />
          </Panel>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
