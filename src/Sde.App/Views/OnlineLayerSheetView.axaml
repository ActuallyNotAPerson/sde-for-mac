<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             x:Class="Sde.App.Views.OnlineLayerSheetView"
             x:DataType="sh:OnlineLayerSheetViewModel">
  <StackPanel Spacing="12">
    <TextBlock Classes="secondary" TextWrapping="Wrap"
               Text="Paste the address of a public ArcGIS FeatureServer or MapServer layer. Its features are copied into this database's map layers, so the map works offline afterwards." />
    <StackPanel Spacing="4">
      <TextBlock Classes="fieldLabel" Text="Layer address" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Text="{Binding Url}" PlaceholderText="https://…/FeatureServer/0" AutomationProperties.Name="ArcGIS layer address" />
        <Button Grid.Column="1" Content="Check" Command="{Binding CheckCommand}" IsEnabled="{Binding !IsBusy}" />
      </Grid>
    </StackPanel>
    <Border Classes="subtle" IsVisible="{Binding HasInfo}">
      <StackPanel Spacing="2">
        <TextBlock Classes="medium" Text="{Binding InfoText}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{Binding CopyrightText}" TextWrapping="Wrap" IsVisible="{Binding HasCopyright}" />
      </StackPanel>
    </Border>
    <StackPanel Spacing="4">
      <TextBlock Classes="fieldLabel" Text="Download" />
      <RadioButton GroupName="OnlineExtent" Content="The area the map shows now" IsChecked="{Binding IsAreaInView}"
                   AutomationProperties.Name="Download the features in the area the map shows now" />
      <RadioButton GroupName="OnlineExtent" Content="The whole layer" IsChecked="{Binding WholeLayer}"
                   AutomationProperties.Name="Download the whole layer" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
      <ProgressBar IsIndeterminate="True" Width="120" AutomationProperties.Name="Working" />
      <TextBlock Classes="muted" Text="{Binding Status}" VerticalAlignment="Center" />
    </StackPanel>
    <Border Classes="subtle" IsVisible="{Binding HasProblem}">
      <TextBlock Classes="issue required" Text="{Binding Problem}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding !IsBusy}" MinWidth="90" HorizontalContentAlignment="Center" />
      <Button Classes="primary" Content="Add layer" Command="{Binding AddCommand}" IsEnabled="{Binding !IsBusy}" MinWidth="90" HorizontalContentAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
