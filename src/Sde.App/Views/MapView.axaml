<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sde.App.ViewModels"
             xmlns:v="using:Sde.App.Views"
             xmlns:maps="using:Sde.App.Maps"
             xmlns:app="using:Sde.App"
             x:Class="Sde.App.Views.MapView"
             x:DataType="vm:MapViewModel">
  <DockPanel Margin="28,22,28,18">
    <!-- Header -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Spacing="2">
        <TextBlock Classes="h1" Text="Map" />
        <TextBlock Classes="secondary" Text="Where the structures are, coloured by their result." />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Basemap" VerticalAlignment="Center" Classes="secondary" />
        <ComboBox ItemsSource="{Binding Basemaps}" SelectedItem="{Binding Basemap}" MinWidth="200" AutomationProperties.Name="Basemap">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="maps:Basemap">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </Grid>

    <!-- What a click or drag does, and the zoom buttons -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <RadioButton GroupName="MapMode" Content="Open" IsChecked="{Binding IsBrowse, Mode=OneWay}"
                     Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:MapMode.Browse}"
                     AutomationProperties.Name="Open mode: click a structure to open it" />
        <RadioButton GroupName="MapMode" Content="Select" IsChecked="{Binding IsSelect, Mode=OneWay}"
                     Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:MapMode.Select}"
                     AutomationProperties.Name="Select mode: drag a box to check structures" />
        <RadioButton GroupName="MapMode" Content="Set location" IsChecked="{Binding IsSetLocation, Mode=OneWay}"
                     Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:MapMode.SetLocation}"
                     AutomationProperties.Name="Set location mode: click the map to place a structure" />
      </StackPanel>
      <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Hint}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="18,0" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Name="ZoomInButton" Content="+" MinWidth="34" HorizontalContentAlignment="Center" AutomationProperties.Name="Zoom in" />
        <Button Name="ZoomOutButton" Content="−" MinWidth="34" HorizontalContentAlignment="Center" AutomationProperties.Name="Zoom out" />
        <Button Content="Show all" Command="{Binding FitToStructuresCommand}" AutomationProperties.Name="Zoom to show all structures" />
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="*,304">
      <!-- The map -->
      <Border Classes="card" Padding="0" ClipToBounds="True" CornerRadius="10">
        <Grid>
          <maps:MapCanvas Name="Surface" Background="{DynamicResource SubtleBg}"
                          AutomationProperties.Name="Map of the structures. The list beside the map has the same structures." />
          <Border Classes="card" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="8,3" IsVisible="{Binding HasAttribution}">
            <TextBlock Classes="muted" Text="{Binding Attribution}" FontSize="11" />
          </Border>
          <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10" Padding="12,6" IsVisible="{Binding HasBasemapProblem}">
            <TextBlock Classes="secondary" Text="{Binding BasemapProblem}" TextWrapping="Wrap" MaxWidth="460" />
          </Border>
          <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20,14" IsVisible="{Binding OnMapCount, Converter={x:Static app:Converters.IsZero}}">
            <StackPanel Spacing="4" MaxWidth="360">
              <TextBlock Classes="h3" Text="No structures on the map yet" HorizontalAlignment="Center" />
              <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center"
                         Text="A structure appears here once it has a latitude and longitude. Use Set location to click each one on the map, or add coordinates in bulk." />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Legend, messages and the list -->
      <DockPanel Grid.Column="1" Margin="14,0,0,0">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
          <TextBlock Classes="eyebrow" Text="SHOW" />
          <ItemsControl ItemsSource="{Binding Classes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MapClassViewModel">
                <CheckBox IsChecked="{Binding IsOn}" Margin="0,0,0,2" AutomationProperties.Name="{Binding SpokenName}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                             Fill="{Binding ColourKey, Converter={x:Static v:MapConverters.ResourceBrush}}" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Count}" Margin="8,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Spacing="2" IsVisible="{Binding HasUnplaced}">
            <TextBlock Text="{Binding UnplacedText}" TextWrapping="Wrap" FontWeight="Medium" />
            <Button Classes="link" Content="Add coordinates in Import &amp; export" Command="{Binding ShowCoordinateToolsCommand}" HorizontalAlignment="Left"
                    AutomationProperties.Name="Open Import and export to add coordinates in bulk" />
          </StackPanel>

          <!-- Set location -->
          <StackPanel Spacing="6" IsVisible="{Binding IsSetLocation}">
            <TextBlock Classes="eyebrow" Text="STRUCTURE TO PLACE" />
            <ComboBox ItemsSource="{Binding Unplaced}" SelectedItem="{Binding PlaceTarget}" HorizontalAlignment="Stretch"
                      PlaceholderText="Structures without coordinates" AutomationProperties.Name="Structure to place">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MapPointViewModel">
                  <TextBlock Text="{Binding Address}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <!-- Result of the last action -->
          <Border Classes="subtle" IsVisible="{Binding HasMessage}">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasChecked}">
                <Button Content="Show in Structures" Command="{Binding ShowCheckedCommand}" />
                <Button Classes="subtle" Content="Clear" Command="{Binding ClearCheckedCommand}" AutomationProperties.Name="Uncheck all structures" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Classes="eyebrow" Text="{Binding CountText, StringFormat='STRUCTURES, {0}'}" Margin="0,6,0,0" />
        </StackPanel>

        <Button DockPanel.Dock="Bottom" Content="Open assessment" Command="{Binding OpenSelectedCommand}" IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"
                Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Border Classes="card" Padding="0" Margin="0,4,0,0">
          <ListBox Name="PointList" Classes="rows" ItemsSource="{Binding Visible}" SelectedItem="{Binding Selected}" Background="Transparent"
                   AutomationProperties.Name="Structures on the map">
            <ListBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding OpenSelectedCommand}" />
            </ListBox.KeyBindings>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MapPointViewModel">
                <StackPanel Margin="4,2" AutomationProperties.Name="{Binding SpokenName}">
                  <TextBlock Text="{Binding Address}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="muted" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
