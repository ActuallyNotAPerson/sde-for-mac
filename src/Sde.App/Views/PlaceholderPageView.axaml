<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Sde.App.ViewModels.Shell"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.PlaceholderPageView"
             x:DataType="shell:PlaceholderPageViewModel">
  <!-- A page that is in the sidebar before its feature is built: what it will hold, as an empty state. -->
  <DockPanel Margin="{StaticResource PagePadding}">
    <c:PageHeader DockPanel.Dock="Top" Title="{Binding Title}" Subtitle="{Binding Subtitle}" />
    <Border Classes="card">
      <c:EmptyState Icon="{Binding Icon}" Title="{Binding EmptyTitle}" Text="{Binding EmptyText}" />
    </Border>
  </DockPanel>
</UserControl>
