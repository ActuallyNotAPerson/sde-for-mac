<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:v="using:Sde.App.Views"
             x:Class="Sde.App.Views.CommentsSheetView"
             x:DataType="sh:CommentsSheetViewModel">
  <!-- The editor's Comments: the assessment's threads, with reply, resolve and a new comment -->
  <StackPanel Spacing="12">
    <TextBlock Classes="secondary" Text="{Binding Address}" TextTrimming="CharacterEllipsis" />
    <ScrollViewer MaxHeight="520" HorizontalScrollBarVisibility="Disabled">
      <v:CommentThreadsView DataContext="{Binding Threads}" Margin="0,0,12,0" />
    </ScrollViewer>
    <Button Content="Done" HorizontalAlignment="Right" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding CancelCommand}" />
  </StackPanel>
</UserControl>
