<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Sde.App"
             xmlns:vm="using:Sde.App.ViewModels"
             xmlns:interop="using:Sde.Interop"
             x:Class="Sde.App.Views.EnterpriseImportView"
             x:DataType="vm:EnterpriseImportViewModel">
  <Border Classes="card">
    <StackPanel Spacing="12">
      <StackPanel Spacing="2">
        <TextBlock Classes="h2" Text="Create structures from a parcel spreadsheet" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="SDE's “Enterprise Import”: turn an assessor's or GIS export (.xlsx or .csv) into structures, one per row, so inspectors start with the address, owner and flood-zone details filled in." />
      </StackPanel>

      <Button Content="Choose spreadsheet…" Command="{Binding ChooseFileCommand}" IsVisible="{Binding !HasFile}" />

      <StackPanel Spacing="14" IsVisible="{Binding HasFile}">
        <!-- File, sheet, header row -->
        <Border Classes="subtle" Padding="14">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="semibold" Text="{Binding FileName}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TableSummary}" Classes="muted" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSeveralSheets}">
                  <TextBlock Text="Sheet" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding SheetNames}" SelectedItem="{Binding SelectedSheet}" MinWidth="160" AutomationProperties.Name="Sheet" />
                </StackPanel>
                <CheckBox Content="First row has the column names" IsChecked="{Binding FirstRowIsHeader}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Button Content="Choose another…" Command="{Binding ChooseFileCommand}" />
              <Button Content="Close" Command="{Binding CloseCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Saved mappings -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Saved mapping" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding SavedMappings}" SelectedItem="{Binding SelectedSaved}" MinWidth="300" PlaceholderText="None (map the columns below)" AutomationProperties.Name="Saved mapping">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="interop:EnterpriseMapping"><TextBlock Text="{Binding Name}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Save mapping" Command="{Binding SaveMappingCommand}" />
          <Button Classes="link" Content="Delete" Command="{Binding DeleteMappingCommand}"
                  IsVisible="{Binding SelectedSaved, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <!-- Column mapping, in the original screen's four groups -->
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Choose the column that holds each detail. Columns named like the field (e.g. “City”, “Zip Code”) are picked for you. You need at least a street number or street name." />
        <Grid ColumnDefinitions="*,*">
          <Grid.DataTemplates>
              <DataTemplate x:DataType="vm:EnterpriseFieldGroup">
                <Border Classes="subtle" Padding="14" Margin="0,0,10,10">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="h3" Text="{Binding Title}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EnterpriseFieldRowViewModel">
                          <StackPanel Spacing="4" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="0.75*,*">
                              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"
                                         FontWeight="{Binding IsMapped, Converter={x:Static app:Converters.BoldIf}}" />
                              <ComboBox Grid.Column="1" ItemsSource="{Binding Columns}" SelectedItem="{Binding Column}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Label, StringFormat='Column for {0}'}" />
                            </Grid>
                            <Grid ColumnDefinitions="0.75*,*" IsVisible="{Binding IsMapped}">
                              <TextBlock Text="holds" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding HasModes}" />
                              <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" HorizontalAlignment="Stretch" IsVisible="{Binding HasModes}" AutomationProperties.Name="{Binding Label, StringFormat='What the {0} column holds'}">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ModeOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="0.75*,*,*" IsVisible="{Binding HasTypeTexts}" ColumnSpacing="6">
                              <TextBlock Text="where the text is" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0" />
                              <TextBox Grid.Column="1" Text="{Binding Owner.ResidentialText}" PlaceholderText="Residential" ToolTip.Tip="Text meaning residential" />
                              <TextBox Grid.Column="2" Text="{Binding Owner.NonResidentialText}" PlaceholderText="Non-Residential" ToolTip.Tip="Text meaning non-residential" />
                            </Grid>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
          </Grid.DataTemplates>
          <ItemsControl ItemsSource="{Binding LeftGroups}" />
          <ItemsControl Grid.Column="1" ItemsSource="{Binding RightGroups}" />
        </Grid>

        <!-- Preview -->
        <Border Classes="subtle" Padding="14">
          <StackPanel Spacing="8">
            <TextBlock Classes="h3" Text="What will be created" />
            <TextBlock Text="{Binding MappingProblems}" Classes="issue required" TextWrapping="Wrap"
                       IsVisible="{Binding MappingProblems, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="semibold" Text="{Binding PreviewSummary}" />
            <Grid ColumnDefinitions="30,44,2.2*,1.4*,2*">
              <TextBlock Grid.Column="1" Classes="eyebrow" Text="ROW" />
              <TextBlock Grid.Column="2" Classes="eyebrow" Text="ADDRESS" />
              <TextBlock Grid.Column="3" Classes="eyebrow" Text="OWNER" />
            </Grid>
            <ItemsControl ItemsSource="{Binding PreviewRows}" MaxHeight="340">
              <ItemsControl.Template>
                <ControlTemplate><ScrollViewer><ItemsPresenter /></ScrollViewer></ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EnterprisePreviewRowViewModel">
                  <Grid ColumnDefinitions="30,44,2.2*,1.4*,2*" Margin="0,3">
                    <CheckBox IsChecked="{Binding Include}" IsEnabled="{Binding CanInclude}" AutomationProperties.Name="{Binding RowNumber, StringFormat='Import row {0}'}" />
                    <TextBlock Grid.Column="1" Text="{Binding RowNumber}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Address}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding Owner}" Classes="secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Text="{Binding Note}" Classes="issue" Classes.required="{Binding IsProblem}" Classes.recommended="{Binding !IsProblem}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Classes="primary" Content="Create checked structures" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}" />
              <CheckBox Content="Remember this mapping" IsChecked="{Binding RememberMapping}"
                        IsVisible="{Binding SelectedSaved, Converter={x:Static ObjectConverters.IsNull}}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
