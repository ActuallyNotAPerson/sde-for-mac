<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:vm="using:Sde.App.ViewModels"
             x:Class="Sde.App.Views.CopyValuesSheetView"
             x:DataType="sh:CopyValuesSheetViewModel">
  <StackPanel Spacing="14">
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
      <StackPanel Spacing="4">
        <TextBlock Classes="fieldLabel" Text="From the areas of" />
        <ComboBox ItemsSource="{Binding Layers}" SelectedItem="{Binding Layer}" HorizontalAlignment="Stretch" AutomationProperties.Name="Layer of areas to copy from">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MapLayerViewModel">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Classes="fieldLabel" Text="Their field" />
        <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SourceField}" HorizontalAlignment="Stretch" MaxDropDownHeight="400"
                  AutomationProperties.Name="Field of the areas to copy" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="4">
        <TextBlock Classes="fieldLabel" Text="Into the structure field" />
        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" HorizontalAlignment="Stretch" MaxDropDownHeight="400"
                  AutomationProperties.Name="Structure field to copy into" />
      </StackPanel>
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="16">
      <RadioButton GroupName="CopyWhich" IsChecked="{Binding OnlySelected}" IsEnabled="{Binding HasSelection}" Content="{Binding SelectedText}"
                   AutomationProperties.Name="Copy onto the selected structures" />
      <RadioButton GroupName="CopyWhich" IsChecked="{Binding AllStructures}" Content="{Binding AllText}"
                   AutomationProperties.Name="Copy onto every structure on the map" />
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Classes="medium" Text="{Binding SummaryText}" AutomationProperties.LiveSetting="Polite" />
      <Border Classes="card flush" IsVisible="{Binding HasRows}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="32,2*,*,*,2*" Margin="10,6">
            <TextBlock Grid.Column="1" Classes="eyebrow" Text="STRUCTURE" />
            <TextBlock Grid.Column="2" Classes="eyebrow" Text="NOW" />
            <TextBlock Grid.Column="3" Classes="eyebrow" Text="NEW" />
            <TextBlock Grid.Column="4" Classes="eyebrow" Text="HOW IT WAS MATCHED" />
          </Grid>
          <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sh:CopyValueRowViewModel">
                  <Border Classes="rule" Padding="10,4">
                    <Grid ColumnDefinitions="32,2*,*,*,2*">
                      <CheckBox IsChecked="{Binding IsTicked}" IsEnabled="{Binding CanCopy}" VerticalAlignment="Center" AutomationProperties.Name="{Binding TickName}" />
                      <TextBlock Grid.Column="1" Text="{Binding Address}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding Now}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Classes="medium" Text="{Binding New}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Classes="muted" Text="{Binding How}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Each value goes in through the same checks as typing it in the editor. The copy is one change in each structure's history, so it can be reverted. Final, Letter sent and checked-out assessments are left as they are." />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
      <Button Classes="primary" Content="{Binding CopyText}" Command="{Binding CopyCommand}" IsDefault="True" MinWidth="90" HorizontalContentAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
