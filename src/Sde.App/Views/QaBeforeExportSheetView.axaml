<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.QaBeforeExportSheetView"
             x:DataType="sh:QaBeforeExportSheetViewModel">
  <!-- Before an SDE export or a submission folder: open quality errors among the assessments -->
  <StackPanel Spacing="14">
    <TextBlock Classes="secondary" Text="{Binding Message}" TextWrapping="Wrap" />
    <Border Classes="subtle">
      <ItemsControl ItemsSource="{Binding Examples}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
              <c:Icon Kind="ErrorCircle" Size="14" Classes="danger" Margin="0,2,8,0" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1" Classes="sm" Text="{Binding}" TextWrapping="Wrap" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
      <Button Content="Export anyway" Command="{Binding ExportAnywayCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
      <Button Classes="primary" Content="Show them on Review" Command="{Binding ShowOnReviewCommand}" IsDefault="True" HorizontalContentAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
