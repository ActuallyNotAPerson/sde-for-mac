<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             x:Class="Sde.App.Views.BulkAutoFillSheetView"
             x:DataType="sh:BulkAutoFillSheetViewModel">
  <StackPanel Spacing="12" Width="680">
    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="Values that would replace something already entered aren't ticked; tick them to use them." />
    <ScrollViewer MaxHeight="400">
      <ItemsControl ItemsSource="{Binding Structures}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="sh:StructureProposalsViewModel">
            <Border Classes="subtle" Padding="12,8" Margin="0,0,0,8">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Address}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding HasMessage}"
                           Classes="issue" Classes.required="{Binding IsError}" Classes.recommended="{Binding !IsError}" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sh:ProposalRowViewModel">
                      <Grid ColumnDefinitions="30,1.3*,1.3*,1.6*" Margin="0,2">
                        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanCheck}" AutomationProperties.Name="{Binding CheckLabel}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="2" Text="{Binding CurrentText}" Classes="secondary" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                          <TextBlock Text="{Binding ProposedText}" TextWrapping="Wrap" />
                          <TextBlock Classes="issue recommended" FontSize="11" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Caution}" />
    <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontWeight="Medium" IsVisible="{Binding ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Done" Command="{Binding CancelCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
      <Button Classes="primary" Content="Apply ticked values" Command="{Binding ApplyCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
