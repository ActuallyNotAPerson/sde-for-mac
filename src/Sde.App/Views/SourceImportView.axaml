<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Sde.App"
             xmlns:vm="using:Sde.App.ViewModels"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.SourceImportView"
             x:DataType="vm:SourceImportViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,18,28,28" Spacing="16" MaxWidth="1120" HorizontalAlignment="Left">
      <Button Classes="subtle" Command="{Binding BackCommand}" HorizontalAlignment="Left" Margin="-10,0,0,0" AutomationProperties.Name="Back to Import and export">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:Icon Kind="CaretLeft" Size="14" />
          <TextBlock Text="Import &amp; export" />
        </StackPanel>
      </Button>
      <StackPanel Spacing="2">
        <TextBlock Classes="h1" Text="Import inspections or parcels" />
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="Turn inspections from a permit system or a spreadsheet into assessments, or a parcel list or assessor roll into structures. Each one remembers its source and record ID, so importing an updated file later only changes what changed in it: your edits in SDE are kept, and a blank cell never clears anything." />
      </StackPanel>

      <!-- No file yet -->
      <Border Classes="card" IsVisible="{Binding !HasFile}">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="Start with a file" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Export the inspections or parcels from the system that holds them (a permit system's inspection report, an assessor roll, a spreadsheet, a shapefile's .dbf) as Excel, CSV or DBF. It can have one row per record, or one row per checklist item. You can also drop the file on this page." />
          <Button Classes="primary" Content="Choose file…" Command="{Binding ChooseFileCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <StackPanel Spacing="16" IsVisible="{Binding HasFile}">
        <!-- 1. The export and the profile -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="h2" Text="1. The file" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="semibold" Text="{Binding FileName}" />
                  <TextBlock Text="{Binding TableSummary}" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding SheetNames}" SelectedItem="{Binding SelectedSheet}" MinWidth="150" IsVisible="{Binding HasSeveralSheets}" AutomationProperties.Name="Sheet" />
                <Button Content="Choose another…" Command="{Binding ChooseFileCommand}" />
                <Button Content="Close" Command="{Binding CloseCommand}" />
              </StackPanel>
            </Grid>
            <Border Classes="subtle" Padding="14">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="medium" Text="Profile" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding SavedProfiles}" SelectedItem="{Binding SelectedProfile}" MinWidth="220" PlaceholderText="None saved yet" AutomationProperties.Name="Saved profile" />
                  <TextBlock Text="Save as" VerticalAlignment="Center" Classes="secondary" Margin="8,0,0,0" />
                  <TextBox Text="{Binding ProfileName}" Width="200" AutomationProperties.Name="Profile name" />
                  <Button Content="Save profile" Command="{Binding SaveProfileCommand}" />
                  <Button Classes="link" Content="Delete" Command="{Binding DeleteProfileCommand}" VerticalAlignment="Center"
                          IsVisible="{Binding SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="A profile remembers how a source's files map to SDE. It's saved when you import and used again for the next file with the same record ID column; it isn't part of the database." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Start from an example" VerticalAlignment="Center" Classes="secondary" />
                  <ComboBox ItemsSource="{Binding ExampleProfiles}" SelectedItem="{Binding SelectedExample}" MinWidth="220" PlaceholderText="Choose an example"
                            AutomationProperties.Name="Example profile" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <Button Classes="link" Content="Use a profile someone shared…" Command="{Binding ImportProfileCommand}" />
                  <Button Classes="link" Content="Show profiles in Finder" Command="{Binding ShowProfilesFolderCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding ProfileNotes}" Classes="issue recommended" TextWrapping="Wrap"
                           IsVisible="{Binding ProfileNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- 2. Layout -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Classes="h2" Text="2. What the file is and how it's laid out" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="The source and record ID link each assessment or structure to its record. With an inspection ID too, every inspection of a record becomes its own assessment." />
            </StackPanel>
            <Grid ColumnDefinitions="170,320,40,170,320" RowDefinitions="Auto,Auto" RowSpacing="10">
              <TextBlock Classes="medium" Text="Source" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding SourceName}" PlaceholderText="e.g. Permits, County assessor"
                       ToolTip.Tip="The system or list the file comes from. It's shown next to each record ID and keeps two sources' record IDs apart."
                       AutomationProperties.Name="Source name" />
              <TextBlock Grid.Column="3" Text="Each record becomes" VerticalAlignment="Center" />
              <ComboBox Grid.Column="4" SelectedIndex="{Binding ModeIndex}" HorizontalAlignment="Stretch" AutomationProperties.Name="Each record becomes">
                <ComboBoxItem Content="An assessment (inspections)" />
                <ComboBoxItem Content="A structure (parcels, assessor roll)" />
              </ComboBox>

              <TextBlock Grid.Row="1" Text="New records match" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding MatchByIndex}" HorizontalAlignment="Stretch"
                        ToolTip.Tip="How a record not imported before finds its structure in SDE. A record that matches several structures is shown as ambiguous and isn't imported."
                        AutomationProperties.Name="Match new records to structures by">
                <ComboBoxItem Content="By record ID only" />
                <ComboBoxItem Content="By parcel number" />
                <ComboBoxItem Content="By address" />
              </ComboBox>
              <CheckBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Content="Ignore leading zeros (00123 is 123)" IsChecked="{Binding ParcelIgnoreLeadingZeros}"
                        IsVisible="{Binding IsMatchByParcel}" />
              <CheckBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Content="The unit (apartment, suite) must match too" IsChecked="{Binding AddressMatchUnit}"
                        IsVisible="{Binding IsMatchByAddress}" />
            </Grid>
            <Grid ColumnDefinitions="170,320,40,170,320" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
              <TextBlock Text="Each row is" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" SelectedIndex="{Binding LayoutIndex}" HorizontalAlignment="Stretch" AutomationProperties.Name="Each row of the file is">
                <ComboBoxItem Content="One record" />
                <ComboBoxItem Content="One checklist item of a record" />
              </ComboBox>
              <TextBlock Grid.Column="3" Text="Only rows where" VerticalAlignment="Center" />
              <ComboBox Grid.Column="4" ItemsSource="{Binding RawColumns}" SelectedItem="{Binding FilterColumn}" HorizontalAlignment="Stretch"
                        ToolTip.Tip="For example Inspection Type, to leave out other kinds of inspection" AutomationProperties.Name="Filter column" />

              <TextBlock Classes="medium" Grid.Row="1" Text="Record ID" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding RawColumns}" SelectedItem="{Binding RecordIdColumn}" HorizontalAlignment="Stretch" AutomationProperties.Name="Record ID column" />
              <TextBlock Grid.Row="1" Grid.Column="3" Text="Inspection ID" VerticalAlignment="Center" IsVisible="{Binding IsInspectionsMode}" />
              <ComboBox Grid.Row="1" Grid.Column="4" ItemsSource="{Binding RawColumns}" SelectedItem="{Binding InspectionIdColumn}" HorizontalAlignment="Stretch"
                        IsVisible="{Binding IsInspectionsMode}" AutomationProperties.Name="Inspection ID column" />

              <TextBlock Grid.Row="2" Text="Checklist item" VerticalAlignment="Center" IsVisible="{Binding IsChecklistLayout}" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding RawColumns}" SelectedItem="{Binding ItemColumn}" HorizontalAlignment="Stretch" IsVisible="{Binding IsChecklistLayout}" AutomationProperties.Name="Checklist item column" />
              <TextBlock Grid.Row="2" Grid.Column="3" Text="Item's value" VerticalAlignment="Center" IsVisible="{Binding IsChecklistLayout}" />
              <ComboBox Grid.Row="2" Grid.Column="4" ItemsSource="{Binding RawColumns}" SelectedItem="{Binding ValueColumn}" HorizontalAlignment="Stretch" IsVisible="{Binding IsChecklistLayout}" AutomationProperties.Name="Checklist value column" />
            </Grid>
            <StackPanel Spacing="4" IsVisible="{Binding HasFilter}">
              <TextBlock Classes="muted" Text="Tick the values to import (none ticked imports every row):" />
              <ItemsControl ItemsSource="{Binding FilterValues}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SourceFilterValueViewModel">
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Include}" Margin="0,0,18,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 3. Fields -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="h2" Text="3. Where each SDE field comes from" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Pick the column for each field, or type a value to use for every record (e.g. the cause of damage, or the base cost). Checklist items appear as “Checklist: …” columns. Anything left out can be filled in later in SDE. Importing structures uses only the structure's fields." />
              </StackPanel>
              <Button Grid.Column="1" Classes="link" Content="Expand / collapse all" Command="{Binding ExpandAllCommand}" VerticalAlignment="Top" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SourceFieldGroupViewModel">
                  <Expander Header="{Binding Header}" IsExpanded="{Binding IsExpanded}" IsVisible="{Binding IsShown}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SourceFieldRowViewModel">
                          <StackPanel Spacing="4" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="230,300,210,*" ColumnSpacing="10">
                              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap"
                                         FontWeight="{Binding IsMapped, Converter={x:Static app:Converters.BoldIf}}" />
                              <ComboBox Grid.Column="1" ItemsSource="{Binding Columns}" SelectedItem="{Binding Column}" HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="{Binding Label, StringFormat='Column for {0}'}" />
                              <TextBox Grid.Column="2" Text="{Binding Constant}" PlaceholderText="{Binding ConstantHint}"
                                       AutomationProperties.Name="{Binding Label, StringFormat='Value of {0} for every record'}" />
                              <TextBlock Grid.Column="3" Text="{Binding Sample}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnDefinitions="230,300" ColumnSpacing="10" IsVisible="{Binding HasColumn}">
                              <TextBlock Text="holds" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding HasModes}" />
                              <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" HorizontalAlignment="Stretch" IsVisible="{Binding HasModes}"
                                        AutomationProperties.Name="{Binding Label, StringFormat='What the {0} column holds'}">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ModeOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                            </Grid>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="subtle" Padding="14">
              <StackPanel Spacing="8">
                <CheckBox Content="Start new assessments and structures from my default values (Settings → Default values), with the file's values on top" IsChecked="{Binding UseDefaultValues}" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsInspectionsMode}">
                  <TextBlock Text="Copy the record ID into" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding CustomFieldChoices}" SelectedIndex="{Binding RecordIdCustomField}" MinWidth="200"
                            ToolTip.Tip="A custom field is included in the FEMA export, so the state can see each assessment's record ID"
                            AutomationProperties.Name="Custom field that gets the record ID" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- 4. Values to match -->
        <Border Classes="card" IsVisible="{Binding HasValues}">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Classes="h2" Text="4. The file's words, SDE's choices" />
              <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding ValuesSummary}" />
            </StackPanel>
            <Grid ColumnDefinitions="200,240,130,*" ColumnSpacing="10">
              <TextBlock Classes="eyebrow" Text="FIELD" />
              <TextBlock Grid.Column="1" Classes="eyebrow" Text="IN THE FILE" />
              <TextBlock Grid.Column="3" Classes="eyebrow" Text="MEANS IN SDE" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Values}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SourceValueRowViewModel">
                  <Grid ColumnDefinitions="200,240,130,*" ColumnSpacing="10" Margin="0,3">
                    <TextBlock Text="{Binding FieldLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="medium" Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding CountText}" Classes="muted" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="3" ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" IsVisible="{Binding HasChoices}" MinWidth="300"
                              AutomationProperties.Name="{Binding AccessibleName}" />
                    <TextBox Grid.Column="3" Text="{Binding Number}" IsVisible="{Binding !HasChoices}" Width="140" HorizontalAlignment="Left" PlaceholderText="a number"
                             AutomationProperties.Name="{Binding AccessibleName}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- 5. Preview and import -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Classes="h2" Text="5. What will happen" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Each record is matched by its source and record (and inspection) ID. A new record goes to a structure already in SDE only when it matches exactly one (as chosen under New records match); a Final assessment is never changed." />
            </StackPanel>
            <TextBlock Text="Working it out…" Classes="muted" IsVisible="{Binding IsBusy}" />
            <TextBlock Text="{Binding MappingProblems}" Classes="issue required" TextWrapping="Wrap"
                       IsVisible="{Binding MappingProblems, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Border Classes="subtle" Padding="14,10" IsVisible="{Binding NeedsBuildingValueConfirmation}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Classes="medium" Text="{Binding BuildingValueQuestion}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Confirm building value…" Command="{Binding ConfirmBuildingValueCommand}" />
              </Grid>
            </Border>
            <TextBlock Text="{Binding ShapeNotes}" Classes="issue recommended" TextWrapping="Wrap"
                       IsVisible="{Binding ShapeNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="semibold" Text="{Binding PreviewSummary}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="30,190,1.4*,150,270,1.6*" ColumnSpacing="8">
              <TextBlock Grid.Column="1" Classes="eyebrow" Text="RECORD ID" />
              <TextBlock Grid.Column="2" Classes="eyebrow" Text="STRUCTURE" />
              <TextBlock Grid.Column="3" Classes="eyebrow" Text="WILL BE" />
              <TextBlock Grid.Column="4" Classes="eyebrow" Text="RESULT" />
            </Grid>
            <ItemsControl ItemsSource="{Binding PreviewRows}" MaxHeight="420">
              <ItemsControl.Template>
                <ControlTemplate><ScrollViewer><ItemsPresenter /></ScrollViewer></ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SourcePreviewRowViewModel">
                  <Grid ColumnDefinitions="30,190,1.4*,150,270,1.6*" ColumnSpacing="8" Margin="0,4">
                    <CheckBox IsChecked="{Binding Include}" IsEnabled="{Binding CanInclude}" VerticalAlignment="Top" AutomationProperties.Name="{Binding Record, StringFormat='Import {0}'}" />
                    <TextBlock Grid.Column="1" Text="{Binding Record}" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Address}" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    <TextBlock Grid.Column="3" Text="{Binding Status}" Classes="secondary" VerticalAlignment="Top" Margin="0,4,0,0" />
                    <Border Grid.Column="4" Classes="pill" VerticalAlignment="Top" HorizontalAlignment="Left"
                            app:ThemeBrush.Background="{Binding State, Converter={x:Static app:Converters.StatusBackgroundKey}}">
                      <TextBlock Classes="sm medium" Text="{Binding Result}" TextTrimming="CharacterEllipsis"
                                 app:ThemeBrush.Foreground="{Binding State, Converter={x:Static app:Converters.StatusForegroundKey}}" />
                    </Border>
                    <TextBlock Grid.Column="5" Text="{Binding Note}" Classes="issue" Classes.required="{Binding IsProblem}" Classes.recommended="{Binding !IsProblem}"
                               VerticalAlignment="Top" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="primary" Content="{Binding ImportText}" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}" HorizontalAlignment="Left" />
            <!-- What the last import did -->
            <Border Classes="subtle" Padding="14,10" IsVisible="{Binding HasResult}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="medium" Text="{Binding LastResult}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="primary" Content="{Binding ReviewText}" Command="{Binding ReviewCommand}" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
