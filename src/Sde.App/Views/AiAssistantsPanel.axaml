<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sde.App.ViewModels"
             xmlns:c="using:Sde.App.Controls"
             x:Class="Sde.App.Views.AiAssistantsPanel"
             x:DataType="vm:AiAssistantsViewModel">
  <StackPanel Spacing="14">
    <Border Classes="card flush">
      <StackPanel Classes="settingsGroup">
        <Border Classes="settingsRow">
          <ToggleSwitch IsChecked="{Binding AllowEdits}" OnContent="" OffContent="" AutomationProperties.Name="Let AI assistants change this database">
            <ToggleSwitch.Content>
              <StackPanel Spacing="1">
                <TextBlock Classes="medium" Text="Let AI assistants change this database" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Off: an assistant such as Claude can read assessments, check them and make reports and maps, but can't change anything. On: it can also fill in fields, set Draft, Reviewed or Appeal, add structures, events and review comments, and assign teams. Every change is recorded in History as the assistant's, Final and Letter sent assessments stay locked, and it can never delete anything." />
              </StackPanel>
            </ToggleSwitch.Content>
          </ToggleSwitch>
        </Border>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <c:CardHeader Icon="Link" Title="Connect an assistant"
                      Text="The assistant runs SDE in the background to reach this database. Put SDE in the Applications folder and open this database in SDE once before connecting. The setup names this database, so copy it again after you switch databases." />
        <c:Banner Tone="Warning" Icon="Warning" Text="{Binding TranslocationWarning}" IsVisible="{Binding HasTranslocationWarning}" />

        <StackPanel Spacing="6">
          <TextBlock Classes="semibold" Text="Claude Code" />
          <Border Background="{DynamicResource BgSubtle}" CornerRadius="6" Padding="10,8">
            <SelectableTextBlock Classes="mono sm" Text="{Binding ClaudeCodeCommand}" TextWrapping="Wrap" />
          </Border>
          <Button Content="Copy command" Command="{Binding CopyClaudeCodeCommand}" HorizontalAlignment="Left"
                  AutomationProperties.Name="Copy the Claude Code command" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="semibold" Text="Claude Desktop" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="Add this to claude_desktop_config.json (Settings, Developer, Edit Config), then restart Claude Desktop." />
          <Border Background="{DynamicResource BgSubtle}" CornerRadius="6" Padding="10,8">
            <SelectableTextBlock Classes="mono sm" Text="{Binding ClaudeDesktopConfig}" TextWrapping="Wrap" />
          </Border>
          <Button Content="Copy setup" Command="{Binding CopyClaudeDesktopCommand}" HorizontalAlignment="Left"
                  AutomationProperties.Name="Copy the Claude Desktop setup" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <c:CardHeader Icon="History" Title="Recent changes by AI assistants"
                      Text="Each line is one request that changed something. Revert puts back the values from before it; anything changed again since is left as it is." />
        <TextBlock Classes="muted" Text="No AI assistant has changed this database." IsVisible="{Binding HasNoChanges}" />
        <ItemsControl ItemsSource="{Binding Changes}" IsVisible="{Binding HasChanges}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AiChangeRowViewModel">
              <Border Classes="rule" Padding="0,8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="1">
                    <TextBlock Classes="medium" Text="{Binding Summary}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding Detail}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Revert" Command="{Binding RevertCommand}" IsVisible="{Binding CanRevert}" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding RevertName}" />
                  <c:Badge Grid.Column="1" Text="Reverted" IsVisible="{Binding IsReverted}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
