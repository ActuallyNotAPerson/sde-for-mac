<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="using:Sde.App.ViewModels.Editor"
             xmlns:core="using:Sde.Core.Assessments"
             xmlns:app="using:Sde.App"
             x:Class="Sde.App.Views.AssessmentEditorView"
             x:DataType="ed:AssessmentEditorViewModel">

  <UserControl.DataTemplates>
    <!-- A card of fields -->
    <DataTemplate DataType="ed:FieldGroupViewModel">
      <Border Classes="card" IsVisible="{Binding IsVisible}" Margin="0,0,0,14">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasTitle}">
            <StackPanel Spacing="2">
              <TextBlock Classes="h3" Text="{Binding Title}" />
              <TextBlock Classes="muted" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Classes="link" Content="{Binding ActionText}" Command="{Binding ActionCommand}" IsVisible="{Binding HasAction}" VerticalAlignment="Top" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Fields}" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Step 5: cost -->
    <DataTemplate DataType="ed:CostSectionViewModel">
      <StackPanel>
        <StackPanel Margin="0,0,0,16" Spacing="2">
          <TextBlock Classes="h2" Text="{Binding Title}" />
          <TextBlock Classes="secondary" Text="{Binding Subtitle}" />
        </StackPanel>

        <Border Classes="card" Margin="0,0,0,14">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="h3" Text="Square footage" />
                <TextBlock Classes="muted" Text="Add the building's footprint as rectangles (length × width × stories), or type a total." TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding Editor.SquareFootage, Converter={x:Static app:Converters.SquareFeet}}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Editor.Shapes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ed:ShapeViewModel">
                  <Border Classes="subtle" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="110,*,120,Auto">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Kind}" FontWeight="Medium" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6">
                        <TextBox Text="{Binding Description}" PlaceholderText="Description (optional)" Width="300" HorizontalAlignment="Left" AutomationProperties.Name="Shape description" />
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsTotalOnly}">
                          <TextBlock Text="A" Width="12" VerticalAlignment="Center" Classes="muted" />
                          <NumericUpDown Value="{Binding LengthA}" AutomationProperties.Name="Part A length" PlaceholderText="Length" Width="96" ShowButtonSpinner="False" Minimum="0" FormatString="0.##" />
                          <TextBlock Text="×" VerticalAlignment="Center" />
                          <NumericUpDown Value="{Binding WidthA}" AutomationProperties.Name="Part A width" PlaceholderText="Width" Width="96" ShowButtonSpinner="False" Minimum="0" FormatString="0.##" />
                          <TextBlock Text="×" VerticalAlignment="Center" />
                          <NumericUpDown Value="{Binding StoriesA}" AutomationProperties.Name="Part A stories" PlaceholderText="Stories" Width="80" Minimum="1" Maximum="99" FormatString="0" />
                          <TextBlock Text="stories" VerticalAlignment="Center" Classes="muted" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasB}">
                          <TextBlock Text="B" Width="12" VerticalAlignment="Center" Classes="muted" />
                          <NumericUpDown Value="{Binding LengthB}" AutomationProperties.Name="Part B length" PlaceholderText="Length" Width="96" ShowButtonSpinner="False" Minimum="0" FormatString="0.##" />
                          <TextBlock Text="×" VerticalAlignment="Center" />
                          <NumericUpDown Value="{Binding WidthB}" AutomationProperties.Name="Part B width" PlaceholderText="Width" Width="96" ShowButtonSpinner="False" Minimum="0" FormatString="0.##" />
                          <TextBlock Text="×" VerticalAlignment="Center" />
                          <NumericUpDown Value="{Binding StoriesB}" AutomationProperties.Name="Part B stories" PlaceholderText="Stories" Width="80" Minimum="1" Maximum="99" FormatString="0" />
                          <TextBlock Text="stories" VerticalAlignment="Center" Classes="muted" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasC}">
                          <TextBlock Text="C" Width="12" VerticalAlignment="Center" Classes="muted" />
                          <NumericUpDown Value="{Binding LengthC}" AutomationProperties.Name="Part C length" PlaceholderText="Length" Width="96" ShowButtonSpinner="False" Minimum="0" FormatString="0.##" />
                          <TextBlock Text="×" VerticalAlignment="Center" />
                          <NumericUpDown Value="{Binding WidthC}" AutomationProperties.Name="Part C width" PlaceholderText="Width" Width="96" ShowButtonSpinner="False" Minimum="0" FormatString="0.##" />
                          <TextBlock Text="×" VerticalAlignment="Center" />
                          <NumericUpDown Value="{Binding StoriesC}" AutomationProperties.Name="Part C stories" PlaceholderText="Stories" Width="80" Minimum="1" Maximum="99" FormatString="0" />
                          <TextBlock Text="stories" VerticalAlignment="Center" Classes="muted" />
                        </StackPanel>
                        <NumericUpDown Value="{Binding Total}" AutomationProperties.Name="Total square feet" IsVisible="{Binding IsTotalOnly}" PlaceholderText="Total square feet" Width="200"
                                       HorizontalAlignment="Left" ShowButtonSpinner="False" Minimum="0" FormatString="N0" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Total, Converter={x:Static app:Converters.SquareFeet}}" Classes="money" VerticalAlignment="Center" FontWeight="Medium" />
                      <Button Grid.Column="3" Classes="subtle" Content="✕" AutomationProperties.Name="Remove shape" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Remove"
                              Command="{Binding RemoveCommand}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="+ Rectangle" Command="{Binding Editor.AddShapeCommand}" CommandParameter="r" />
              <Button Content="+ L-shape" Command="{Binding Editor.AddShapeCommand}" CommandParameter="l" />
              <Button Content="+ T-shape" Command="{Binding Editor.AddShapeCommand}" CommandParameter="t" />
              <Button Content="+ U-shape" Command="{Binding Editor.AddShapeCommand}" CommandParameter="u" />
              <Button Content="+ Type a total" Command="{Binding Editor.AddShapeCommand}" CommandParameter="c" />
            </StackPanel>
          </StackPanel>
        </Border>

        <ContentControl Content="{Binding Basics}" />

        <Border Classes="card" Margin="0,0,0,14" IsVisible="{Binding Editor.CostAdjustments.Count, Converter={x:Static app:Converters.IsPositive}}">
          <StackPanel Spacing="8">
            <StackPanel Spacing="2">
              <TextBlock Classes="h3" Text="Cost adjustments" />
              <TextBlock Classes="muted" Text="Features that add to the replacement cost. The list depends on the type of building." />
            </StackPanel>
            <Grid ColumnDefinitions="*,64,130,150,120" Margin="0,4,0,0">
              <TextBlock Classes="eyebrow" Text="ITEM" />
              <TextBlock Grid.Column="1" Classes="eyebrow" Text="UNIT" />
              <TextBlock Grid.Column="2" Classes="eyebrow" Text="QUANTITY" />
              <TextBlock Grid.Column="3" Classes="eyebrow" Text="UNIT COST" />
              <TextBlock Grid.Column="4" Classes="eyebrow" Text="TOTAL" TextAlignment="Right" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Editor.CostAdjustments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ed:CostAdjustmentRowViewModel">
                  <Grid ColumnDefinitions="*,64,130,150,120" Margin="0,2">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Units}" Classes="muted" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="2" Value="{Binding Quantity}" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} quantity'}" ShowButtonSpinner="False" Minimum="0" FormatString="0.##" Margin="0,0,10,0" />
                    <NumericUpDown Grid.Column="3" Value="{Binding UnitCost}" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} unit cost'}" ShowButtonSpinner="False" FormatString="N2" Margin="0,0,10,0" Classes="number">
                      <NumericUpDown.InnerLeftContent><TextBlock Classes="adorn" Text="$" Margin="10,0,0,0" /></NumericUpDown.InnerLeftContent>
                    </NumericUpDown>
                    <TextBlock Grid.Column="4" Text="{Binding TotalCost, Converter={x:Static app:Converters.Money}}" Classes="money" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card" Margin="0,0,0,14">
          <StackPanel Spacing="8">
            <StackPanel Spacing="2">
              <TextBlock Classes="h3" Text="Additional adjustments" />
              <TextBlock Classes="muted" Text="Anything else to include in the replacement cost (up to 7 lines)." />
            </StackPanel>
            <Grid ColumnDefinitions="*,130,140,120" Margin="0,4,0,0">
              <TextBlock Classes="eyebrow" Text="DESCRIPTION" />
              <TextBlock Grid.Column="1" Classes="eyebrow" Text="QUANTITY" />
              <TextBlock Grid.Column="2" Classes="eyebrow" Text="UNIT COST" />
              <TextBlock Grid.Column="3" Classes="eyebrow" Text="TOTAL" TextAlignment="Right" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Editor.AdditionalAdjustments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ed:AdditionalAdjustmentRowViewModel">
                  <Grid ColumnDefinitions="*,130,140,120" Margin="0,2">
                    <TextBox Text="{Binding Name}" PlaceholderText="{Binding Number, StringFormat='Adjustment {0}'}" AutomationProperties.Name="{Binding Number, StringFormat='Additional adjustment {0} name'}" Margin="0,0,10,0" />
                    <NumericUpDown Grid.Column="1" Value="{Binding Quantity}" AutomationProperties.Name="{Binding Number, StringFormat='Additional adjustment {0} quantity'}" ShowButtonSpinner="False" FormatString="0.##" Margin="0,0,10,0" />
                    <NumericUpDown Grid.Column="2" Value="{Binding UnitCost}" AutomationProperties.Name="{Binding Number, StringFormat='Additional adjustment {0} unit cost'}" ShowButtonSpinner="False" FormatString="N2" Margin="0,0,10,0" Classes="number">
                      <NumericUpDown.InnerLeftContent><TextBlock Classes="adorn" Text="$" Margin="10,0,0,0" /></NumericUpDown.InnerLeftContent>
                    </NumericUpDown>
                    <TextBlock Grid.Column="3" Text="{Binding TotalCost, Converter={x:Static app:Converters.Money}}" Classes="money" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <ContentControl Content="{Binding Depreciation}" />

        <Border Classes="card" Margin="0,0,0,14">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" >
            <TextBlock Grid.Row="0" Text="Base cost × square footage × geographic adjustment" Classes="secondary" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Editor.Cost, Converter={x:Static app:Converters.Money}}" Classes="money" />
            <TextBlock Grid.Row="1" Text="+ Adjustments" Classes="secondary" Margin="0,4,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Editor.Assessment.TotalAdjustments, Converter={x:Static app:Converters.Money}}" Classes="money" Margin="0,4,0,0" />
            <TextBlock Grid.Row="2" Text="Replacement cost" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Editor.Assessment.TotalReplacementCost, Converter={x:Static app:Converters.Money}}" Classes="money" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Grid.Row="3" Text="− Depreciation" Classes="secondary" Margin="0,4,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Editor.Assessment.DepreciationValue, Converter={x:Static app:Converters.Percent}}" Classes="money" Margin="0,4,0,0" />
            <TextBlock Grid.Row="4" Text="Actual cash value (pre-damage)" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Editor.Assessment.ComputedActualCashValue, Converter={x:Static app:Converters.Money}}" Classes="money" FontWeight="SemiBold" Margin="0,8,0,0" />
          </Grid>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- Step 6: damage by element -->
    <DataTemplate DataType="ed:DamageSectionViewModel">
      <StackPanel>
        <StackPanel Margin="0,0,0,16" Spacing="2">
          <TextBlock Classes="h2" Text="{Binding Title}" />
          <TextBlock Classes="secondary" Text="{Binding Subtitle}" />
        </StackPanel>
        <Border Classes="card" Margin="0,0,0,14" Background="{DynamicResource StatusUndeterminedBg}" IsVisible="{Binding Editor.IsUndetermined}">
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource StatusUndeterminedFg}"
                     Text="Damage is marked as undetermined on the Inspection step, so these values don't affect the result." />
        </Border>
        <Border Classes="card" Margin="0,0,0,14" IsVisible="{Binding Editor.HasDepthTables}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="h3" Text="Depth table" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Editor.DepthHelperText}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="12,0,0,0">
                <ComboBox ItemsSource="{Binding Editor.DepthTableChoices}" SelectedItem="{Binding Editor.SelectedDepthTable}" IsVisible="{Binding Editor.HasSeveralDepthTables}"
                          Width="200" AutomationProperties.Name="Depth table to use">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:DepthDamageTable"><TextBlock Text="{Binding Name}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Classes="primary" Content="Suggest from depth table" Command="{Binding Editor.SuggestDamageCommand}" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Editor.DepthResultText}" IsVisible="{Binding Editor.DepthResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Editor.HasSuggestions}">
              <TextBlock Classes="issue recommended" TextWrapping="Wrap" Text="{Binding Editor.SuggestionsText}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Accept all" Command="{Binding Editor.AcceptAllSuggestionsCommand}" Margin="12,0,0,0"
                      AutomationProperties.Name="Accept all suggested damage values" />
            </Grid>
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="0,0,0,14">
          <StackPanel Spacing="6">
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="For each part of the building, estimate how much of it is damaged (0% = untouched, 100% = must be fully replaced). FEMA's tables set how much of the replacement cost each part represents for this type of building." />
            <Grid ColumnDefinitions="1.25*,64,2.2*,108,108" Margin="0,8,0,2">
              <TextBlock Classes="eyebrow" Text="ELEMENT" />
              <TextBlock Grid.Column="1" Classes="eyebrow" Text="SHARE" TextAlignment="Right" Margin="0,0,16,0" ToolTip.Tip="Share of the replacement cost (FEMA's table)" />
              <TextBlock Grid.Column="2" Classes="eyebrow" Text="% DAMAGED" />
              <TextBlock Grid.Column="3" Classes="eyebrow" Text="ELEMENT COST" TextAlignment="Right" />
              <TextBlock Grid.Column="4" Classes="eyebrow" Text="DAMAGE" TextAlignment="Right" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Editor.Elements}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ed:ElementRowViewModel">
                  <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,10">
                    <Grid ColumnDefinitions="1.25*,64,2.2*,108,108">
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBlock Grid.Column="1" Text="{Binding Share, Converter={x:Static app:Converters.Percent}}" Classes="money secondary" VerticalAlignment="Center" Margin="0,0,16,0" />
                      <StackPanel Grid.Column="2" Spacing="4">
                        <Grid ColumnDefinitions="*,92">
                          <Slider Minimum="0" Maximum="100" Value="{Binding UserDamageDouble}" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} percent damaged'}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="Drag, or type an exact value" />
                          <NumericUpDown Grid.Column="1" Value="{Binding UserDamage}" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} percent damaged'}" Minimum="0" Maximum="100" Increment="5" FormatString="0.##" ShowButtonSpinner="False" Classes="number" VerticalAlignment="Center">
                            <NumericUpDown.InnerRightContent><TextBlock Classes="adorn" Text="%" Margin="0,0,10,0" /></NumericUpDown.InnerRightContent>
                          </NumericUpDown>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <Button Classes="chip" Content="0" Command="{Binding SetDamageCommand}" CommandParameter="0" />
                          <Button Classes="chip" Content="25" Command="{Binding SetDamageCommand}" CommandParameter="25" />
                          <Button Classes="chip" Content="50" Command="{Binding SetDamageCommand}" CommandParameter="50" />
                          <Button Classes="chip" Content="75" Command="{Binding SetDamageCommand}" CommandParameter="75" />
                          <Button Classes="chip" Content="100" Command="{Binding SetDamageCommand}" CommandParameter="100" />
                          <Border Classes="pill" Background="{DynamicResource AccentSoft}" Padding="8,2" Margin="8,0,0,0" IsVisible="{Binding IsSuggested}"
                                  ToolTip.Tip="{Binding SuggestedLabel}">
                            <TextBlock Text="Suggested" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                          </Border>
                          <Button Classes="link" Content="Accept" Command="{Binding AcceptSuggestionCommand}" IsVisible="{Binding IsSuggested}" VerticalAlignment="Center"
                                  Margin="6,0,0,0" AutomationProperties.Name="{Binding AcceptLabel}" />
                        </StackPanel>
                      </StackPanel>
                      <TextBlock Grid.Column="3" Text="{Binding ItemCost, Converter={x:Static app:Converters.Money}}" Classes="money secondary" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding DamageValue, Converter={x:Static app:Converters.Money}}" Classes="money" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
              <Grid ColumnDefinitions="*,120,120">
                <TextBlock Text="Total" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Editor.Assessment.TotalReplacementCost, Converter={x:Static app:Converters.Money}}" Classes="money secondary" />
                <TextBlock Grid.Column="2" Text="{Binding Editor.Assessment.ComputedDamages, Converter={x:Static app:Converters.Money}}" Classes="money" FontWeight="Bold" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- Step 7: result -->
    <DataTemplate DataType="ed:ResultSectionViewModel">
      <StackPanel>
        <StackPanel Margin="0,0,0,16" Spacing="2">
          <TextBlock Classes="h2" Text="{Binding Title}" />
          <TextBlock Classes="secondary" Text="Percent damaged = cost of repairs ÷ value of the building before the damage." />
        </StackPanel>

        <Border Classes="card" Margin="0,0,0,14">
          <StackPanel Spacing="8">
            <TextBlock Classes="h3" Text="Value of the building (before damage)" />
            <RadioButton GroupName="value" IsChecked="{Binding Editor.IsValueAcv, Mode=OneWay}" Command="{Binding Editor.SetValueBasisCommand}" CommandParameter="390">
              <StackPanel>
                <TextBlock Text="Computed actual cash value" FontWeight="Medium" />
                <TextBlock Classes="muted" Text="{Binding Editor.Assessment.ComputedActualCashValue, Converter={x:Static app:Converters.Money}, StringFormat='Replacement cost less depreciation: {0}'}" />
              </StackPanel>
            </RadioButton>
            <RadioButton GroupName="value" IsChecked="{Binding Editor.IsValueAppraisal, Mode=OneWay}" Command="{Binding Editor.SetValueBasisCommand}" CommandParameter="391">
              <StackPanel>
                <TextBlock Text="Professional market appraisal" FontWeight="Medium" />
                <TextBlock Classes="muted" Text="Value of the structure only, from a licensed appraiser" />
              </StackPanel>
            </RadioButton>
            <RadioButton GroupName="value" IsChecked="{Binding Editor.IsValueTax, Mode=OneWay}" Command="{Binding Editor.SetValueBasisCommand}" CommandParameter="392">
              <StackPanel>
                <TextBlock Text="Adjusted tax assessed value" FontWeight="Medium" />
                <TextBlock Classes="muted" Text="{Binding Editor.AdjustedTaxValue, Converter={x:Static app:Converters.Money}, StringFormat='Tax assessed value × factor adjustment: {0}'}" />
              </StackPanel>
            </RadioButton>
            <ContentControl Content="{Binding ValueInputs}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <Border Classes="card" Margin="0,0,0,14">
          <StackPanel Spacing="8">
            <TextBlock Classes="h3" Text="Cost of repairs" />
            <RadioButton GroupName="repair" IsChecked="{Binding Editor.IsRepairComputed, Mode=OneWay}" Command="{Binding Editor.SetRepairBasisCommand}" CommandParameter="393">
              <StackPanel>
                <TextBlock Text="Computed damages" FontWeight="Medium" />
                <TextBlock Classes="muted" Text="{Binding Editor.Assessment.ComputedDamages, Converter={x:Static app:Converters.Money}, StringFormat='From the damage step: {0}'}" />
              </StackPanel>
            </RadioButton>
            <RadioButton GroupName="repair" IsChecked="{Binding Editor.IsRepairContractor, Mode=OneWay}" Command="{Binding Editor.SetRepairBasisCommand}" CommandParameter="394">
              <TextBlock Text="Contractor's estimate" FontWeight="Medium" />
            </RadioButton>
            <RadioButton GroupName="repair" IsChecked="{Binding Editor.IsRepairCommunity, Mode=OneWay}" Command="{Binding Editor.SetRepairBasisCommand}" CommandParameter="395">
              <TextBlock Text="Community's estimate" FontWeight="Medium" />
            </RadioButton>
            <ContentControl Content="{Binding RepairInputs}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- Step 8: photos & notes -->
    <DataTemplate DataType="ed:PhotosSectionViewModel">
      <StackPanel>
        <StackPanel Margin="0,0,0,16" Spacing="2">
          <TextBlock Classes="h2" Text="{Binding Title}" />
          <TextBlock Classes="secondary" Text="{Binding Subtitle}" />
        </StackPanel>
        <Border Classes="card" Margin="0,0,0,14">
          <StackPanel Spacing="12">
            <Border Name="DropZone" DragDrop.AllowDrop="True" BorderBrush="{DynamicResource CardBorder}" BorderThickness="2" CornerRadius="10"
                    Padding="20" Background="{DynamicResource SubtleBg}">
              <StackPanel HorizontalAlignment="Center" Spacing="8">
                <TextBlock Text="Drag photos here" HorizontalAlignment="Center" FontWeight="Medium" />
                <Button Content="Choose photos…" HorizontalAlignment="Center" Command="{Binding Editor.ChoosePhotosCommand}" />
                <TextBlock Classes="muted" Text="Reports show the photos in this order, the starred one first. Drag a photo by its handle, or use the arrows, to change the order." HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Classes="subtle" Background="{DynamicResource AccentSoft}" Padding="12,10" IsVisible="{Binding Editor.HasPhotoOffer}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding Editor.PhotoOfferText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Use as the structure's location" Command="{Binding Editor.UsePhotoLocationCommand}" IsVisible="{Binding Editor.CanUsePhotoLocation}" />
                  <Button Content="Use as the inspection date" Command="{Binding Editor.UsePhotoDateCommand}" IsVisible="{Binding Editor.CanUsePhotoDate}" />
                  <Button Classes="subtle" Content="Not now" Command="{Binding Editor.DismissPhotoOfferCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Editor.Photos}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ed:PhotoViewModel">
                  <Border Classes="subtle photoCard" Width="236" Margin="0,0,12,12" Padding="8" DragDrop.AllowDrop="True">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Border Classes="dragHandle" Background="Transparent" Padding="4,0" Cursor="SizeAll" ToolTip.Tip="Drag to change the order" VerticalAlignment="Center">
                          <TextBlock Text="⠿" FontSize="16" Classes="muted" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding PositionText}" Classes="muted" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <Button Grid.Column="2" Classes="subtle" Content="‹" Command="{Binding MoveEarlierCommand}" Padding="8,2"
                                AutomationProperties.Name="{Binding MoveEarlierLabel}" ToolTip.Tip="Move earlier" />
                        <Button Grid.Column="3" Classes="subtle" Content="›" Command="{Binding MoveLaterCommand}" Padding="8,2"
                                AutomationProperties.Name="{Binding MoveLaterLabel}" ToolTip.Tip="Move later" />
                      </Grid>
                      <Button Padding="0" Background="Transparent" Command="{Binding OpenCommand}" ToolTip.Tip="Open">
                        <Panel Height="150" Width="220">
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                          <TextBlock Text="{Binding FileName}" IsVisible="{Binding !HasThumbnail}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" />
                        </Panel>
                      </Button>
                      <TextBox Text="{Binding Description}" PlaceholderText="Description" AutomationProperties.Name="Photo description" />
                      <Grid ColumnDefinitions="*,Auto">
                        <ToggleButton Classes="star" IsChecked="{Binding IsDefault, Mode=OneWay}" Command="{Binding MakeDefaultCommand}"
                                      AutomationProperties.Name="{Binding DefaultLabel}" ToolTip.Tip="{Binding DefaultLabel}">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="★" IsVisible="{Binding IsDefault}" />
                            <TextBlock Text="☆" IsVisible="{Binding !IsDefault}" />
                            <TextBlock Text="Report photo" IsVisible="{Binding IsDefault}" />
                            <TextBlock Text="Use on reports" IsVisible="{Binding !IsDefault}" />
                          </StackPanel>
                        </ToggleButton>
                        <Button Grid.Column="1" Classes="link" Content="Remove" Foreground="{DynamicResource RequiredFg}" Command="{Binding RemoveCommand}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="0,0,0,14">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Classes="h3" Text="Your fields" />
              <TextBlock Classes="muted" Text="Rename these in Settings (e.g. “Permit number”)." />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Editor.CustomFields}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ed:CustomFieldEntryViewModel">
                  <StackPanel Classes="field">
                    <TextBlock Classes="fieldLabel" Text="{Binding Label}" />
                    <TextBox Text="{Binding Text}" MaxLength="50" AutomationProperties.Name="{Binding Label}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- Steps 1-4: plain forms -->
    <DataTemplate DataType="ed:SectionViewModel">
      <StackPanel>
        <Grid Margin="0,0,0,16" ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" Text="{Binding Title}" />
            <TextBlock Classes="secondary" Text="{Binding Subtitle}" />
          </StackPanel>
          <Button Grid.Column="1" Content="Look up online…" Command="{Binding OnlineLookupCommand}" IsVisible="{Binding HasOnlineLookup}" VerticalAlignment="Top"
                  ToolTip.Tip="Coordinates from the Census geocoder and the flood zone from FEMA's flood map. You choose what to use." />
        </Grid>
        <ItemsControl ItemsSource="{Binding Groups}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="subtle" Content="‹ Structures" Command="{Binding CloseCommand}" VerticalAlignment="Center" Margin="0,0,14,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Classes="h2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="muted" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Classes="muted" Text="{Binding SaveState}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <Button Classes="chip" Content="{Binding StatusLabel, StringFormat='{}{0} ▾'}" AutomationProperties.Name="{Binding StatusLabel, StringFormat='Status: {0}. Change status'}"
                  ToolTip.Tip="Where this assessment is in review. Final and Letter sent lock it.">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Draft" Command="{Binding SetStatusCommand}" CommandParameter="Draft" />
                <MenuItem Header="Reviewed" Command="{Binding SetStatusCommand}" CommandParameter="Reviewed" />
                <MenuItem Header="Final (locks it)" Command="{Binding SetStatusCommand}" CommandParameter="Final" />
                <MenuItem Header="Letter sent (locks it)" Command="{Binding SetStatusCommand}" CommandParameter="LetterSent" />
                <MenuItem Header="Appeal" Command="{Binding SetStatusCommand}" CommandParameter="Appeal" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Content="Assessments ▾">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Spacing="4" MinWidth="240">
                  <TextBlock Classes="eyebrow" Text="ASSESSMENTS OF THIS STRUCTURE" Margin="4,0,0,4" />
                  <ItemsControl ItemsSource="{Binding OtherAssessments}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="ed:AssessmentChoice">
                        <Button Classes="subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding Label}"
                                Command="{Binding Open}" CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Separator />
                  <Button Classes="subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="+ New assessment of this structure"
                          Command="{Binding NewAssessmentForStructureCommand}" ToolTip.Tip="For a re-inspection or a new damage event" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Content="Reports ▾">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Summary report" Command="{Binding PrintCommand}" CommandParameter="Summary" />
                <MenuItem Header="Summary report (no photos)" Command="{Binding PrintCommand}" CommandParameter="Summary-NoPhotos" />
                <MenuItem Header="Detailed report" Command="{Binding PrintCommand}" CommandParameter="Detail" />
                <MenuItem Header="Detailed report (no photos)" Command="{Binding PrintCommand}" CommandParameter="Detail-NoPhotos" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Content="⋯" AutomationProperties.Name="More actions">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Save now" Command="{Binding SaveCommand}" InputGesture="Cmd+S" />
                <MenuItem Header="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" InputGesture="Cmd+Z" />
                <MenuItem Header="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" InputGesture="Cmd+Shift+Z" />
                <MenuItem Header="History…" Command="{Binding ShowHistoryCommand}" />
                <MenuItem Header="Copy from another structure…" Command="{Binding CopyFromCommand}" IsEnabled="{Binding IsEditable}" />
                <Separator />
                <MenuItem Header="Improvements and SI…" Command="{Binding ShowImprovementsCommand}" />
                <MenuItem Header="Appeal…" Command="{Binding ShowAppealCommand}" />
                <MenuItem Header="Mark letter as sent…" Command="{Binding MarkLetterSentCommand}" />
                <Separator />
                <MenuItem Header="Move to Recently Deleted" Command="{Binding DeleteAssessmentCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="232,*,316">
      <!-- Steps -->
      <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
        <ListBox Classes="steps" Margin="10,12" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="ed:SectionViewModel">
              <Grid ColumnDefinitions="30,*">
                <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource SubtleBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                  <TextBlock Text="{Binding Title}" FontWeight="Medium" />
                  <TextBlock FontSize="11" Text="{Binding StatusText}" Foreground="{DynamicResource RecommendedFg}" IsVisible="{Binding !IsDone}"
                             Classes.req="{Binding HasRequiredIssues}" />
                  <TextBlock FontSize="11" Text="✓ Complete" Foreground="{DynamicResource StatusNotSubstantialFg}" IsVisible="{Binding IsDone}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.Styles>
            <Style Selector="TextBlock.req">
              <Setter Property="Foreground" Value="{DynamicResource RequiredFg}" />
            </Style>
          </ListBox.Styles>
        </ListBox>
      </Border>

      <!-- Current step -->
      <ScrollViewer Grid.Column="1" Name="StepScroller" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,28" MaxWidth="980" HorizontalAlignment="Left">
          <Border Classes="card" Background="{DynamicResource AccentSoft}" BorderThickness="0" Margin="0,0,0,14" IsVisible="{Binding IsLocked}">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding LockText}" FontWeight="Medium" TextWrapping="Wrap" />
              <TextBlock Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding ChangedInOlderVersion}"
                         Text="It was changed in an older version of SDE after it was locked. Check it, then reopen and lock it again." />
            </StackPanel>
          </Border>
          <ContentControl Content="{Binding SelectedSection}" IsEnabled="{Binding IsEditable}" />
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
            <Button Content="‹ Back" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" />
            <Button Grid.Column="2" Classes="primary" Command="{Binding NextCommand}" IsVisible="{Binding CanGoNext}"
                    Content="{Binding NextTitle, StringFormat='Next: {0} ›'}" />
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- Live result -->
      <Border Grid.Column="2" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0">
        <ScrollViewer>
          <StackPanel Margin="16,18" Spacing="14">
            <Border Classes="card" app:ThemeBrush.Background="{Binding State, Converter={x:Static app:Converters.StatusBackgroundKey}}" BorderThickness="0">
              <StackPanel Spacing="4">
                <TextBlock Classes="eyebrow" Text="PERCENT DAMAGED" />
                <TextBlock Text="{Binding PercentText}" FontSize="44" FontWeight="Bold" app:ThemeBrush.Foreground="{Binding State, Converter={x:Static app:Converters.StatusForegroundKey}}" />
                <TextBlock Text="{Binding Determination}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                           app:ThemeBrush.Foreground="{Binding State, Converter={x:Static app:Converters.StatusForegroundKey}}" />
                <TextBlock Text="{Binding StateHint}" FontSize="12" TextWrapping="Wrap" Classes="secondary" Margin="0,4,0,0" />
              </StackPanel>
            </Border>

            <!-- Cumulative damage (Settings; off by default). A separate finding: FEMA's result above never changes. -->
            <Border Classes="card" Padding="16,12" BorderThickness="0" IsVisible="{Binding ShowCumulative}" Name="CumulativeCard"
                    app:ThemeBrush.Background="{Binding CumulativeState, Converter={x:Static app:Converters.StatusBackgroundKey}}">
              <StackPanel Spacing="4">
                <TextBlock Classes="eyebrow" Text="CUMULATIVE DAMAGE" />
                <TextBlock Text="{Binding CumulativeTitle}" FontWeight="SemiBold" TextWrapping="Wrap"
                           app:ThemeBrush.Foreground="{Binding CumulativeState, Converter={x:Static app:Converters.StatusForegroundKey}}"
                           ToolTip.Tip="Damage from the events in the look-back period added together, as set in Settings. FEMA's reports and exports keep FEMA's own result." />
                <TextBlock Text="{Binding CumulativeVerdict}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="A separate finding: the percent damaged and determination above don't change." />
                <Expander Header="How this was worked out" HorizontalAlignment="Stretch" Margin="0,4,0,0" AutomationProperties.Name="How cumulative damage was worked out">
                  <ItemsControl ItemsSource="{Binding CumulativeLines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,4" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </StackPanel>
            </Border>

            <Border Classes="card" Padding="16,12">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="secondary" Text="Replacement cost" />
                  <TextBlock Grid.Column="1" Classes="money" Text="{Binding Assessment.TotalReplacementCost, Converter={x:Static app:Converters.MoneyWhole}}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="secondary" Text="Depreciation" />
                  <TextBlock Grid.Column="1" Classes="money" Text="{Binding Assessment.DepreciationValue, Converter={x:Static app:Converters.Percent}}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="secondary" Text="Actual cash value" />
                  <TextBlock Grid.Column="1" Classes="money" Text="{Binding Assessment.ComputedActualCashValue, Converter={x:Static app:Converters.MoneyWhole}}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="secondary" Text="Computed damages" />
                  <TextBlock Grid.Column="1" Classes="money" Text="{Binding Assessment.ComputedDamages, Converter={x:Static app:Converters.MoneyWhole}}" />
                </Grid>
                <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,2" />
                <StackPanel Spacing="1">
                  <TextBlock Classes="muted" Text="Repair cost used" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding RepairBasisName}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Classes="money" FontWeight="SemiBold" Text="{Binding RepairBasisAmount, Converter={x:Static app:Converters.MoneyWhole}}" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="1">
                  <TextBlock Classes="muted" Text="Building value used" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding ValueBasisName}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Classes="money" FontWeight="SemiBold" Text="{Binding ValueBasisAmount, Converter={x:Static app:Converters.MoneyWhole}}" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card" Padding="16,12">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h3" Text="Needs attention" />
                  <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center"
                             Text="{Binding RequiredIssueCount, StringFormat='{}{0} required'}" Foreground="{DynamicResource RequiredFg}" />
                </Grid>
                <TextBlock Classes="muted" Text="Nothing required or recommended is missing." IsVisible="{Binding Issues.Count, Converter={x:Static app:Converters.IsZero}}" />
                <ItemsControl ItemsSource="{Binding Issues}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ed:IssueItem">
                      <Button Classes="subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,4"
                              Command="{Binding Go}" CommandParameter="{Binding Issue}">
                        <Grid ColumnDefinitions="14,*">
                          <Ellipse Width="7" Height="7" app:ThemeBrush.Fill="{Binding Severity, Converter={x:Static app:Converters.IssueBrushKey}}" VerticalAlignment="Top" Margin="0,5,0,0" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding FieldName}" FontSize="12" FontWeight="Medium" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Message}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding SuggestionCount, Converter={x:Static app:Converters.IsPositive}}"
                           Text="{Binding SuggestionCount, StringFormat='Plus {0} optional details (owner and mailing information) you can fill in later.'}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
