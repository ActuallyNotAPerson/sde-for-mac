<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Sde.App.ViewModels.Sheets"
             x:Class="Sde.App.Views.SetEventSheetView"
             x:DataType="sh:SetEventSheetViewModel">
  <StackPanel Spacing="12">
    <TextBlock Classes="secondary" Text="{Binding Intro}" TextWrapping="Wrap" />
    <StackPanel Spacing="4">
      <TextBlock Classes="fieldLabel" Text="Event" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="New event…" Command="{Binding NewEventCommand}" Margin="8,0,0,0" />
        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch" AutomationProperties.Name="Event" />
      </DockPanel>
    </StackPanel>
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="An assessment is in one event at most; this moves any that are in another. Edit history records the change." />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
      <Button Classes="primary" Content="Set event" IsDefault="True" Command="{Binding ApplyCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
