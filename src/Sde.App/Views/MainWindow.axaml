<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sde.App.ViewModels"
        xmlns:ed="using:Sde.App.ViewModels.Editor"
        xmlns:v="using:Sde.App.Views"
        xmlns:svc="using:Sde.App.Services"
        xmlns:sh="using:Sde.App.ViewModels.Sheets"
        xmlns:shell="using:Sde.App.ViewModels.Shell"
        xmlns:c="using:Sde.App.Controls"
        xmlns:data="using:Sde.Data"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="Sde.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Substantial Damage Estimator"
        Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        Background="{DynamicResource WindowBg}">

  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenu>
          <NativeMenuItem Header="New Residential Structure" Gesture="Cmd+N" Command="{Binding Structures.NewStructureCommand}" CommandParameter="1" />
          <NativeMenuItem Header="New Non-Residential Structure" Gesture="Cmd+Shift+N" Command="{Binding Structures.NewStructureCommand}" CommandParameter="2" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Open Database…" Gesture="Cmd+O" Command="{Binding Settings.OpenDatabaseCommand}" />
          <NativeMenuItem Header="Open Recent">
            <NativeMenu />
          </NativeMenuItem>
          <NativeMenuItem Header="New Database…" Command="{Binding Settings.NewDatabaseCommand}" />
          <NativeMenuItem Header="Save a Copy of the Database…" Command="{Binding Settings.BackUpCommand}" />
          <NativeMenuItem Header="Move or Copy the Database…" Command="{Binding DatabaseSwitcher.MoveOrCopyCommand}" />
          <NativeMenuItem Header="Restore from Backup…" Command="{Binding RestoreBackupCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Save" Gesture="Cmd+S" Command="{Binding SaveCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Import SDE Data…" Gesture="Cmd+I" Command="{Binding ImportExport.ChooseSdeFolderCommand}" />
          <NativeMenuItem Header="Export All to SDE…" Gesture="Cmd+E" Command="{Binding ImportExport.ExportAllCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Import Inspections or Parcels…" Gesture="Cmd+Shift+I" Command="{Binding OpenSourceImportCommand}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Edit">
        <NativeMenu>
          <NativeMenuItem Header="Undo" Gesture="Cmd+Z" Click="OnUndo" />
          <NativeMenuItem Header="Redo" Gesture="Cmd+Shift+Z" Click="OnRedo" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Cut" Gesture="Cmd+X" Click="OnCut" />
          <NativeMenuItem Header="Copy" Gesture="Cmd+C" Click="OnCopy" />
          <NativeMenuItem Header="Paste" Gesture="Cmd+V" Click="OnPaste" />
          <NativeMenuItem Header="Select All" Gesture="Cmd+A" Click="OnSelectAll" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Find" Gesture="Cmd+F" Command="{Binding FindCommand}" />
          <NativeMenuItem Header="Search and Replace…" Command="{Binding Structures.SearchReplaceCommand}" />
          <NativeMenuItem Header="Set a Field on Checked Structures…" Command="{Binding Structures.BulkEditCommand}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="View">
        <!-- The pages, ⌘1 to ⌘9 in the sidebar's order, are put first by MainWindow.axaml.cs. -->
        <NativeMenu>
          <NativeMenuItem Header="Search and Commands…" Gesture="Cmd+K" Command="{Binding Palette.OpenCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Previous Step" Gesture="Cmd+OemOpenBrackets" Command="{Binding PreviousStepCommand}" />
          <NativeMenuItem Header="Next Step" Gesture="Cmd+OemCloseBrackets" Command="{Binding NextStepCommand}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Window">
        <NativeMenu>
          <NativeMenuItem Header="Minimize" Gesture="Cmd+M" Click="OnMinimize" />
          <NativeMenuItem Header="Zoom" Click="OnZoom" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Help">
        <NativeMenu>
          <NativeMenuItem Header="SDE Help" Command="{Binding ShowHelpCommand}" />
          <NativeMenuItem Header="FEMA SDE User Manual" Command="{Binding OpenManualCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Show the Walkthrough" Command="{Binding ShowWalkthroughCommand}" />
          <NativeMenuItem Header="Open Sample Database" Command="{Binding OpenSampleDatabaseCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Keyboard Shortcuts" Command="{Binding ShowShortcutsCommand}" />
          <NativeMenuItem Header="Show Log Folder" Command="{Binding ShowLogsCommand}" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Window.DataTemplates>
    <DataTemplate DataType="vm:StructuresViewModel"><v:StructuresView /></DataTemplate>
    <DataTemplate DataType="ed:AssessmentEditorViewModel"><v:AssessmentEditorView /></DataTemplate>
    <DataTemplate DataType="vm:ImportExportViewModel"><v:ImportExportView /></DataTemplate>
    <DataTemplate DataType="vm:SourceImportViewModel"><v:SourceImportView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:TrashViewModel"><v:TrashView /></DataTemplate>
    <DataTemplate DataType="vm:MapViewModel"><v:MapView /></DataTemplate>
    <DataTemplate DataType="vm:DashboardViewModel"><v:DashboardView /></DataTemplate>
    <DataTemplate DataType="shell:PlaceholderPageViewModel"><v:PlaceholderPageView /></DataTemplate>
    <DataTemplate DataType="sh:ImprovementsSheetViewModel"><v:ImprovementsSheetView /></DataTemplate>
    <DataTemplate DataType="sh:AppealSheetViewModel"><v:AppealSheetView /></DataTemplate>
    <DataTemplate DataType="sh:EventSheetViewModel"><v:EventSheetView /></DataTemplate>
    <DataTemplate DataType="sh:ManageEventsSheetViewModel"><v:ManageEventsSheetView /></DataTemplate>
    <DataTemplate DataType="sh:SetEventSheetViewModel"><v:SetEventSheetView /></DataTemplate>
    <DataTemplate DataType="sh:OwnerLettersSheetViewModel"><v:OwnerLettersSheetView /></DataTemplate>
    <DataTemplate DataType="sh:FieldHelpSheetViewModel"><v:FieldHelpSheetView /></DataTemplate>
    <DataTemplate DataType="sh:HelpIndexSheetViewModel"><v:HelpIndexSheetView /></DataTemplate>
    <DataTemplate DataType="sh:WalkthroughSheetViewModel"><v:WalkthroughSheetView /></DataTemplate>
    <DataTemplate DataType="sh:ManualMissingSheetViewModel">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding MissingMessage}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Done" Command="{Binding CancelCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
          <Button Classes="primary" Content="Open FEMA's SDE page" Command="{Binding OpenFemaPageCommand}" IsDefault="True" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <!-- Field data sheets (photos, online look-up) -->
    <DataTemplate DataType="sh:AutoFillSheetViewModel"><v:AutoFillSheetView /></DataTemplate>
    <DataTemplate DataType="sh:BulkAutoFillSheetViewModel"><v:BulkAutoFillSheetView /></DataTemplate>
    <DataTemplate DataType="sh:PhotoFolderSheetViewModel"><v:PhotoFolderSheetView /></DataTemplate>
    <DataTemplate DataType="sh:RestoreBackupSheetViewModel">
      <StackPanel Spacing="12">
        <TextBlock Classes="secondary" Text="{Binding Intro}" TextWrapping="Wrap" />
        <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding Selected}" MaxHeight="320" IsVisible="{Binding HasBackups}" AutomationProperties.Name="Backups">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="sh:BackupRowViewModel">
              <StackPanel Margin="4,2">
                <TextBlock Classes="medium" Text="{Binding When}" />
                <TextBlock Classes="muted" Text="{Binding Detail}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Classes="muted" Text="There are no backups yet." IsVisible="{Binding !HasBackups}" />
        <DockPanel>
          <Button DockPanel.Dock="Left" Classes="link" Content="Show the backups folder" Command="{Binding ShowFolderCommand}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
            <Button Classes="danger" Content="Restore…" Command="{Binding RestoreCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="sh:ReopenSheetViewModel">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        <TextBox Text="{Binding Reason}" PlaceholderText="For example: the owner sent a contractor's estimate" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                 AutomationProperties.Name="Why it is being reopened" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
          <Button Classes="primary" Content="Reopen" Command="{Binding ReopenCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="sh:HistorySheetViewModel">
      <StackPanel Spacing="12">
        <TextBlock Classes="muted" Text="Nothing has been recorded for this assessment yet." IsVisible="{Binding IsEmpty}" />
        <ScrollViewer MaxHeight="420" IsVisible="{Binding !IsEmpty}">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="sh:HistoryRowViewModel">
                <Grid ColumnDefinitions="150,*" Margin="0,4">
                  <StackPanel>
                    <TextBlock Classes="secondary sm" Text="{Binding When}" />
                    <TextBlock Classes="muted xs" Text="{Binding Who}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="medium" Text="{Binding What}" TextWrapping="Wrap" />
                    <TextBlock Classes="secondary" Text="{Binding Change}" IsVisible="{Binding HasChange}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Button Classes="primary" Content="Done" IsDefault="True" HorizontalAlignment="Right" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding CancelCommand}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="sh:NameSheetViewModel">
      <StackPanel Spacing="10">
        <TextBlock Classes="fieldLabel" Text="{Binding Label}" />
        <TextBox Text="{Binding Name}" PlaceholderText="{Binding Placeholder}" AutomationProperties.Name="{Binding Label}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
          <Button Classes="primary" Content="Save" IsDefault="True" Command="{Binding OkCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="sh:BulkEditSheetViewModel">
      <StackPanel Spacing="12">
        <StackPanel Spacing="4">
          <TextBlock Classes="fieldLabel" Text="Field" />
          <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}" HorizontalAlignment="Stretch" MaxDropDownHeight="420"
                    PlaceholderText="Choose a field" AutomationProperties.Name="Field to set" />
        </StackPanel>
        <ContentControl Content="{Binding Input}" IsVisible="{Binding HasField}" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Classes="secondary" />
        <TextBlock Classes="medium" Text="{Binding ResultText}" TextWrapping="Wrap" IsVisible="{Binding ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <DockPanel>
          <Button DockPanel.Dock="Left" Content="Undo this change" Command="{Binding RevertCommand}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Done" Command="{Binding CancelCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
            <Button Classes="primary" Content="Apply" Command="{Binding ApplyCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="sh:SearchReplaceSheetViewModel">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="4">
          <TextBlock Classes="fieldLabel" Text="In" />
          <TextBlock Grid.Column="1" Classes="fieldLabel" Text="Find" />
          <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Replace with" />
          <ComboBox Grid.Row="1" ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}" HorizontalAlignment="Stretch" MaxDropDownHeight="420" AutomationProperties.Name="Field to search">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="data:SearchField"><TextBlock Text="{Binding Label}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Find}" AutomationProperties.Name="Find" />
          <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding ReplaceWith}" AutomationProperties.Name="Replace with" />
        </Grid>
        <TextBlock Text="{Binding MatchText}" Classes="secondary" />
        <ScrollViewer MaxHeight="280">
          <ItemsControl ItemsSource="{Binding Matches}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="data:SearchMatch">
                <Grid ColumnDefinitions="200,*" Margin="0,2">
                  <TextBlock Classes="medium" Text="{Binding Address}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" Classes="secondary">
                    <Run Text="{Binding Before}" /><Run Text=" → " /><Run Text="{Binding After}" />
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Classes="medium" Text="{Binding ResultText}" TextWrapping="Wrap" IsVisible="{Binding ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <DockPanel>
          <Button DockPanel.Dock="Left" Content="Undo this change" Command="{Binding RevertCommand}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Done" Command="{Binding CancelCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
            <Button Classes="primary" Content="Replace all" Command="{Binding ReplaceAllCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="sh:CopyFromSheetViewModel">
      <StackPanel Spacing="12">
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Fills this assessment from one already entered. Location, owner and damage percentages are never copied." />
        <TextBox Text="{Binding Search}" PlaceholderText="Search address or owner" AutomationProperties.Name="Search for the structure to copy from" />
        <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" Height="200" AutomationProperties.Name="Structure to copy from">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="data:StructureSummary">
              <StackPanel Margin="2">
                <TextBlock Classes="medium" Text="{Binding Address}" />
                <TextBlock Classes="muted" Text="{Binding Owner}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Classes="fieldLabel" Text="Copy" />
        <ItemsControl ItemsSource="{Binding Steps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="sh:CopyStepViewModel">
              <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
          <Button Classes="primary" Content="Copy" Command="{Binding CopyCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="sh:ShortcutsSheetViewModel">
      <StackPanel Spacing="12">
        <ItemsControl ItemsSource="{Binding Shortcuts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="sh:Shortcut">
              <Grid ColumnDefinitions="130,*" Margin="0,3">
                <TextBlock Classes="semibold" Text="{Binding Keys}" />
                <TextBlock Grid.Column="1" Text="{Binding Action}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="primary" Content="Done" IsDefault="True" HorizontalAlignment="Right" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding CancelCommand}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="sh:ConfirmSheetViewModel">
      <StackPanel Spacing="16">
        <TextBlock Classes="secondary" Text="{Binding Message}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
          <Button Classes="primary" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True" IsVisible="{Binding IsNotDestructive}"
                  MinWidth="90" HorizontalContentAlignment="Center" />
          <Button Classes="destructive" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsVisible="{Binding IsDestructive}"
                  MinWidth="90" HorizontalContentAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="sh:MoveOrCopySheetViewModel">
      <StackPanel Spacing="14">
        <TextBlock Classes="secondary" Text="{Binding Intro}" TextWrapping="Wrap" />
        <StackPanel Spacing="10">
          <RadioButton GroupName="moveOrCopy" IsChecked="{Binding IsMove}" AutomationProperties.Name="Move it">
            <StackPanel>
              <TextBlock Classes="medium" Text="Move it" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="To another folder or a shared drive, and open it from there." />
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="moveOrCopy" IsChecked="{Binding IsCopy}" AutomationProperties.Name="Copy it and open the copy">
            <StackPanel>
              <TextBlock Classes="medium" Text="Copy it and open the copy" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="The original stays where it is, unchanged." />
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="moveOrCopy" IsChecked="{Binding IsBackup}" AutomationProperties.Name="Save a backup copy">
            <StackPanel>
              <TextBlock Classes="medium" Text="Save a backup copy" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="In a new folder, and keep working in this database." />
            </StackPanel>
          </RadioButton>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
          <Button Classes="primary" Content="Continue…" Command="{Binding ContinueCommand}" IsDefault="True" MinWidth="90" HorizontalContentAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="svc:ErrorSheetViewModel">
      <StackPanel Spacing="14">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        <Button Classes="link" Content="{Binding ShowDetails, Converter={x:Static v:SheetConverters.DetailsToggle}}" Command="{Binding ToggleDetailsCommand}" AutomationProperties.Name="Show details" />
        <TextBox Classes="mono" Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" IsVisible="{Binding ShowDetails}" TextWrapping="Wrap" MaxHeight="260"
                 AutomationProperties.Name="Error details" />
        <Button Classes="primary" Content="OK" IsDefault="True" HorizontalAlignment="Right" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding CancelCommand}" />
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>

  <!--
    The menu's shortcuts again, for when there's no native menu bar (other platforms, and the headless tests). On macOS
    the menu bar handles these keys first. ⌘1 to ⌘9 (the sidebar's pages) are added by MainWindow.axaml.cs.
  -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding EscapeCommand}" />
    <KeyBinding Gesture="Cmd+K" Command="{Binding Palette.OpenCommand}" />
    <KeyBinding Gesture="Cmd+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Cmd+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Cmd+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Cmd+F" Command="{Binding FindCommand}" />
    <KeyBinding Gesture="Cmd+N" Command="{Binding Structures.NewStructureCommand}" CommandParameter="1" />
    <KeyBinding Gesture="Cmd+Shift+N" Command="{Binding Structures.NewStructureCommand}" CommandParameter="2" />
    <KeyBinding Gesture="Cmd+O" Command="{Binding Settings.OpenDatabaseCommand}" />
    <KeyBinding Gesture="Cmd+OemOpenBrackets" Command="{Binding PreviousStepCommand}" />
    <KeyBinding Gesture="Cmd+OemCloseBrackets" Command="{Binding NextStepCommand}" />
  </Window.KeyBindings>

  <Panel>
    <Grid ColumnDefinitions="224,*">
      <!--
        Sidebar. Its top 52 px is under the window's own title bar: the close, minimise and zoom buttons sit there, and
        the empty space drags the window (ElementRole TitleBar).
      -->
      <Border Classes="sidebar">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="52" Background="Transparent" Name="SidebarTitleBar"
                  chrome:WindowDecorationProperties.ElementRole="TitleBar" />

          <!-- Event switcher -->
          <Button DockPanel.Dock="Top" Classes="switcher" Name="EventSwitcher" Margin="10,0,10,10"
                  AutomationProperties.Name="{Binding Events.AccessibleName}" ToolTip.Tip="{Binding Events.Detail}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="switcherIcon">
                <c:Icon Kind="Event" Size="14" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                <TextBlock Classes="caption" Text="Event" />
                <TextBlock Classes="semibold" Text="{Binding Events.Label}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <c:Icon Grid.Column="2" Classes="tertiary" Kind="CaretUpDown" Size="14" />
            </Grid>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Classes="menu" Width="260" DataContext="{Binding Events}" x:DataType="shell:EventSwitcherViewModel">
                  <TextBlock Classes="eyebrow" Text="EVENT" Margin="8,2,8,6" />
                  <ItemsControl ItemsSource="{Binding Events}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="shell:EventChoice">
                        <Button Classes="menuItem" Click="OnFlyoutItemClick"
                                Command="{Binding $parent[ItemsControl].((shell:EventSwitcherViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Name}">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="muted" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <c:Icon Grid.Column="1" Classes="accent" Kind="Check" Size="14" Margin="12,0,0,0">
                              <c:Icon.IsVisible>
                                <MultiBinding Converter="{x:Static v:SheetConverters.Same}">
                                  <Binding />
                                  <Binding Path="$parent[ItemsControl].((shell:EventSwitcherViewModel)DataContext).Selected" />
                                </MultiBinding>
                              </c:Icon.IsVisible>
                            </c:Icon>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="divider" Margin="0,4" />
                  <Button Classes="menuItem" Click="OnFlyoutItemClick" Command="{Binding NewEventCommand}" AutomationProperties.Name="New event">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <c:Icon Kind="Plus" Size="14" />
                      <TextBlock Text="New event…" />
                    </StackPanel>
                  </Button>
                  <Button Classes="menuItem" Click="OnFlyoutItemClick" Command="{Binding ManageEventsCommand}" AutomationProperties.Name="Manage events">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <c:Icon Kind="Edit" Size="14" />
                      <TextBlock Text="Manage events…" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- Database switcher -->
          <Button DockPanel.Dock="Bottom" Classes="switcher" Name="DatabaseButton" Margin="10,8,10,12"
                  AutomationProperties.Name="{Binding DatabaseSwitcher.AccessibleName}" ToolTip.Tip="{Binding CountsText}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="switcherIcon">
                <c:Icon Kind="Database" Size="14" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                <TextBlock Classes="semibold" Text="{Binding DatabaseName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="caption" Text="{Binding StructureCountText}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <c:Icon Grid.Column="2" Classes="tertiary" Kind="CaretUpDown" Size="14" />
            </Grid>
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedLeft">
                <StackPanel Classes="menu" Width="280" DataContext="{Binding DatabaseSwitcher}" x:DataType="shell:DatabaseSwitcherViewModel">
                  <StackPanel Margin="8,2,8,8" Spacing="1">
                    <TextBlock Classes="semibold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" Text="{Binding Folder}" TextTrimming="PathSegmentEllipsis" />
                  </StackPanel>
                  <Border Classes="divider" Margin="0,0,0,4" />
                  <TextBlock Classes="eyebrow" Text="OPEN RECENT" Margin="8,6,8,4" IsVisible="{Binding HasRecent}" />
                  <ItemsControl ItemsSource="{Binding Recent}" IsVisible="{Binding HasRecent}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="shell:RecentDatabase">
                        <Button Classes="menuItem" Click="OnFlyoutItemClick" ToolTip.Tip="{Binding Path}"
                                Command="{Binding $parent[ItemsControl].((shell:DatabaseSwitcherViewModel)DataContext).OpenRecentCommand}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <c:Icon Kind="Database" Size="14" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="divider" Margin="0,4" IsVisible="{Binding HasRecent}" />
                  <Button Classes="menuItem" Click="OnFlyoutItemClick" Command="{Binding OpenCommand}" AutomationProperties.Name="Open database">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <c:Icon Kind="FolderOpen" Size="14" />
                      <TextBlock Grid.Column="1" Text="Open database…" Margin="10,0" />
                      <TextBlock Grid.Column="2" Classes="muted" Text="⌘O" />
                    </Grid>
                  </Button>
                  <Button Classes="menuItem" Click="OnFlyoutItemClick" Command="{Binding NewCommand}" AutomationProperties.Name="New database">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <c:Icon Kind="Plus" Size="14" />
                      <TextBlock Text="New database…" />
                    </StackPanel>
                  </Button>
                  <Button Classes="menuItem" Click="OnFlyoutItemClick" Command="{Binding MoveOrCopyCommand}" AutomationProperties.Name="Move or copy database">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <c:Icon Kind="Copy" Size="14" />
                      <TextBlock Text="Move or copy database…" />
                    </StackPanel>
                  </Button>
                  <Border Classes="divider" Margin="0,4" />
                  <Button Classes="menuItem" Click="OnFlyoutItemClick" Command="{Binding ShowInFinderCommand}" AutomationProperties.Name="Show in Finder">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <c:Icon Kind="Folder" Size="14" />
                      <TextBlock Text="Show in Finder" />
                    </StackPanel>
                  </Button>
                  <Button Classes="menuItem" Click="OnFlyoutItemClick" Command="{Binding BackupsCommand}" AutomationProperties.Name="Backups">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <c:Icon Kind="History" Size="14" />
                      <TextBlock Text="Backups…" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- Pages -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding SidebarGroups}" Margin="10,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="shell:NavGroupViewModel">
                  <StackPanel Spacing="1" Margin="0,0,0,14">
                    <TextBlock Classes="eyebrow" Text="{Binding Title}" Margin="8,0,8,6" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="shell:NavItemViewModel">
                          <Button Classes="nav" Classes.active="{Binding IsActive}" Command="{Binding ShowCommand}"
                                  AutomationProperties.Name="{Binding Title}" ToolTip.Tip="{Binding ToolTip}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <c:Icon Kind="{Binding Icon}" Size="16" Margin="0,0,10,0" />
                              <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              <c:Badge Grid.Column="2" Text="{Binding CountText}" Tone="{Binding CountTone}" IsVisible="{Binding HasCount}" Margin="6,0,0,0" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <DockPanel Grid.Column="1">
        <!--
          The title band: under the window's title bar, so its empty parts drag the window. The page title on the
          left, ⌘K search in the middle, New on the right.
        -->
        <Border DockPanel.Dock="Top" Classes="titleBand" Name="TitleBand" chrome:WindowDecorationProperties.ElementRole="TitleBar">
          <Grid ColumnDefinitions="*,Auto,*">
            <DockPanel Margin="0,0,16,0" VerticalAlignment="Center">
              <!-- Breadcrumb: the page this one belongs to, one click back -->
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasPageParent}" VerticalAlignment="Center">
                <Button Classes="crumb" Content="{Binding PageParent}" Command="{Binding GoToParentCommand}"
                        AutomationProperties.Name="{Binding PageParent, StringFormat='Back to {0}'}" ToolTip.Tip="{Binding PageParent, StringFormat='Back to {0}'}" />
                <c:Icon Kind="CaretRight" Size="12" Classes="tertiary" VerticalAlignment="Center" Margin="0,0,4,0" />
              </StackPanel>
              <TextBlock Classes="title" Text="{Binding PageTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Name="PageTitleText" chrome:WindowDecorationProperties.ElementRole="TitleBar" />
            </DockPanel>
            <Button Grid.Column="1" Classes="searchField" Name="SearchField" Command="{Binding Palette.OpenCommand}"
                    AutomationProperties.Name="Search structures, pages and commands" ToolTip.Tip="Search structures, pages and commands (⌘K)">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <c:Icon Kind="Search" Size="14" />
                <TextBlock Grid.Column="1" Text="Search structures, pages and commands" Margin="8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Border Grid.Column="2" Classes="kbd">
                  <TextBlock Text="⌘K" />
                </Border>
              </Grid>
            </Button>
            <DropDownButton Grid.Column="2" Classes="accent" Name="NewButton" HorizontalAlignment="Right" AutomationProperties.Name="New">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Kind="Plus" Size="14" />
                <TextBlock Text="New" />
              </StackPanel>
              <DropDownButton.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Residential structure" InputGesture="Cmd+N" Command="{Binding Structures.NewStructureCommand}" CommandParameter="1">
                    <MenuItem.Icon><c:Icon Kind="Structures" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Non-residential structure" InputGesture="Cmd+Shift+N" Command="{Binding Structures.NewStructureCommand}" CommandParameter="2">
                    <MenuItem.Icon><c:Icon Kind="NonResidential" /></MenuItem.Icon>
                  </MenuItem>
                  <Separator />
                  <MenuItem Header="Import inspections or parcels…" InputGesture="Cmd+Shift+I" Command="{Binding OpenSourceImportCommand}">
                    <MenuItem.Icon><c:Icon Kind="Import" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Import SDE data…" InputGesture="Cmd+I" Command="{Binding ImportExport.ChooseSdeFolderCommand}">
                    <MenuItem.Icon><c:Icon Kind="Download" /></MenuItem.Icon>
                  </MenuItem>
                  <Separator />
                  <MenuItem Header="Database…" Command="{Binding Settings.NewDatabaseCommand}">
                    <MenuItem.Icon><c:Icon Kind="Database" /></MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>
          </Grid>
        </Border>

        <!-- The sample database is practice only: said on every page. -->
        <c:Banner DockPanel.Dock="Top" Tone="Warning" CornerRadius="0" Padding="20,8" IsVisible="{Binding IsSampleDatabase}"
                  Text="This is the sample database. Changes here are practice only." AutomationProperties.Name="Sample database notice">
          <Button Classes="link semibold" Content="Back to my database" Command="{Binding LeaveSampleDatabaseCommand}" />
        </c:Banner>
        <ContentControl Content="{Binding CurrentPage}" />
      </DockPanel>
    </Grid>

    <!-- Sheets: the rest of the window is dimmed and can't be clicked. -->
    <Border IsVisible="{Binding Sheets.HasSheet}" Classes="scrim" Name="SheetLayer">
      <Border Classes="sheet" Name="SheetCard"
              Classes.small="{Binding Sheets.CurrentSize, Converter={x:Static v:SheetConverters.IsSize}, ConverterParameter=Small}"
              Classes.medium="{Binding Sheets.CurrentSize, Converter={x:Static v:SheetConverters.IsSize}, ConverterParameter=Medium}"
              Classes.large="{Binding Sheets.CurrentSize, Converter={x:Static v:SheetConverters.IsSize}, ConverterParameter=Large}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <TextBlock Classes="h2" Text="{Binding Sheets.CurrentTitle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="icon" Command="{Binding Sheets.CancelCurrentCommand}" VerticalAlignment="Top" Margin="12,-2,-6,0"
                    AutomationProperties.Name="Close" ToolTip.Tip="Close (Esc)">
              <c:Icon Kind="Close" Size="16" />
            </Button>
          </Grid>
          <ContentControl Content="{Binding Sheets.Current}" />
        </DockPanel>
      </Border>
    </Border>

    <!-- ⌘K: the command palette, over everything but the task card -->
    <Panel IsVisible="{Binding Palette.IsOpen}" Name="PaletteLayer">
      <Border Classes="scrim" PointerPressed="OnPaletteScrimPressed" />
      <v:CommandPaletteView DataContext="{Binding Palette}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,64,0,0" />
    </Panel>

    <!-- Toasts, newest at the bottom -->
    <ItemsControl Name="ToastList" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="224,0,0,20">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="8" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="svc:ToastViewModel">
          <c:Toast Title="{Binding Title}" Message="{Binding Message}" Tone="{Binding Tone}"
                   ActionText="{Binding ActionText}" ActionCommand="{Binding ActionCommand}" CloseCommand="{Binding CloseCommand}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- A long task: progress and Stop, over the bottom right corner, above any sheet so Stop can always be pressed. -->
    <Border Classes="card" IsVisible="{Binding Jobs.IsBusy}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" Width="340" Padding="16,12"
            BoxShadow="{DynamicResource ShadowPopup}" AutomationProperties.Name="Task in progress">
      <StackPanel Spacing="6" DataContext="{Binding Jobs.Current}" x:DataType="svc:JobViewModel">
        <TextBlock Classes="semibold" Text="{Binding Title}" />
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsIndeterminate}" AutomationProperties.Name="Progress" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="subtle" Content="Stop" IsVisible="{Binding CanStop}" IsEnabled="{Binding !IsStopping}" Command="{Binding StopCommand}" />
          <TextBlock Classes="muted" Text="{Binding ProgressText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </StackPanel>
    </Border>
  </Panel>
</Window>
