<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sde.App.ViewModels"
             x:Class="Sde.App.Views.TrashView"
             x:DataType="vm:TrashViewModel">
  <DockPanel Margin="28,22,28,18">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="2">
        <TextBlock Classes="h1" Text="Recently deleted" />
        <TextBlock Classes="secondary" Text="{Binding Intro}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" />
      </StackPanel>
      <Button Grid.Column="1" Content="Empty Recently deleted…" Command="{Binding EmptyAllCommand}" IsEnabled="{Binding !IsEmpty}" VerticalAlignment="Center" />
    </Grid>
    <Border Classes="card" Padding="0">
      <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !IsEmpty}">
          <ItemsControl ItemsSource="{Binding Items}" Margin="0,4">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DeletedItemViewModel">
                <Grid ColumnDefinitions="110,*,Auto" Margin="16,10">
                  <Border Classes="pill" Background="{DynamicResource SubtleBg}" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Classes="sm" Text="{Binding Kind}" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Classes="medium" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding When}" /><Run Text=" · " /><Run Text="{Binding DaysLeft}" />
                    </TextBlock>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="primary" Content="Restore" Command="{Binding $parent[UserControl].((vm:TrashViewModel)DataContext).RestoreCommand}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Label, StringFormat='Restore {0}'}" />
                    <Button Content="Delete now…" Command="{Binding $parent[UserControl].((vm:TrashViewModel)DataContext).DeleteNowCommand}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Label, StringFormat='Delete {0} for good'}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Margin="0,60">
          <TextBlock Classes="h3" Text="Nothing here" HorizontalAlignment="Center" />
          <TextBlock Classes="secondary" Text="What you delete appears here for 30 days." HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
