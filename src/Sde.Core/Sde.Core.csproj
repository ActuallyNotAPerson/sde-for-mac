<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDE business logic, free of UI and database code: records (FEMA's data model), the bridge to the
    calculation engine, validation, and the SDE Export.json exchange format.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Sde.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sde.Calculation/Sde.Calculation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
